 1 file changed, 233 insertions(+), 569 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
index ec0a80c7e..6286b8d13 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
@@ -992,6 +992,19 @@ shared uvec2 iq2xxs_grid[256];
 #endif
 #endif
 
+#if defined(DATA_A_IQ2_XXS) || defined(DATA_A_IQ2_XS) || defined(DATA_A_IQ2_S)
+// grid bytes are only 0x08, 0x19 or 0x2b; expand four 2-bit indices to four bytes
+uint iq2_grid_spread(uint c) {
+    c = (c | (c << 12)) & 0x000F000F;
+    c = (c | (c << 6)) & 0x03030303;
+    return c * 17 + ((c >> 1) & 0x01010101) + 0x08080808;
+}
+
+uvec2 iq2_grid_unpack(uint code) {
+    return uvec2(iq2_grid_spread(code & 0xFF), iq2_grid_spread(code >> 8));
+}
+#endif
+
