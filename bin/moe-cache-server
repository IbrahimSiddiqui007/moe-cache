#!/bin/bash
# moe-cache-server: run llama-server with the expert-cache plugin.
#   moe-cache-server MODEL.gguf [--ram GB] [--vram GB] [--ctx N] [--n-cpu-moe N] [--port P] [--llama-server PATH] [--load-method auto|preload|path] [--open] [--dry-run] [-- extra llama-server args]
# --profile NAME  use (and keep learning) a separate usage profile for one kind of work, e.g. coding, thinking, research; default: one shared profile
# --gpu-cache off|auto|MIB  use llama.cpp's GPU expert cache (--moe-cache-mib) on top of this cache: the experts you use most are copied to free VRAM and
#              computed on the GPU. auto = all VRAM the planner sees free minus --gpu-margin GiB (default 1.0; raise it with a large -ub). Not bit-identical to
#              CPU-computed experts (GPU float order), identical to llama.cpp's own cache. Needs llama.cpp 23b0202a1 or newer (API 3 plugin build).
# --ub auto|N  micro-batch size (prompt processing speed: 512 -> 2048 was +58 % at a 6k prompt). auto picks the largest that fits in free VRAM next to the
#              KV cache of --ctx (the GPU compute buffer grows with the context: 3 GiB at 2048 and 128k); with --gpu-cache the default stays at 1024
# --ram      memory the server may use (default: the cgroup limit or free RAM). The cache sizes itself to stay below it.
# MOE_CACHE_PYTHON  python with the gguf package for the planner (default python3)
# --n-cpu-moe  layers whose experts stay on the CPU (default: chosen by the planner from free VRAM)
# --no-ecores  do not let the expert executor use the efficiency cores (hybrid Intel CPUs: up to 4 of them are used by default, about +10-15 %)
# --no-pin     do not pin llama-server's threads. By default on hybrid Intel CPUs (performance + efficiency cores) it gets
#              -C MASK --cpu-strict 1 (one thread on each performance core): about +15 % decode speed measured on an i7-13620H
set -e
umask 077   # the usage profile is private to this user
HERE="$(cd "$(dirname "$0")/.." && pwd)"
MODEL=""; RAM=""; VRAM=""; CTX=8192; NCMOE=""; PORT=8080; LS="${LLAMA_SERVER:-llama-server}"; DRY=0; OPEN=0; METHOD=auto; PIN=1; ECORES=1; PNAME=""; GCACHE=off; GMARGIN=1.0; UBARG=auto; EXTRA=()
while [ $# -gt 0 ]; do case "$1" in
  --ram) RAM=$2; shift 2;; --ub) UBARG=$2; shift 2;; --gpu-cache) GCACHE=$2; shift 2;; --gpu-margin) GMARGIN=$2; shift 2;; --profile) PNAME=$2; shift 2;; --vram) VRAM=$2; shift 2;; --ctx) CTX=$2; shift 2;; --n-cpu-moe) NCMOE=$2; shift 2;;
  --port) PORT=$2; shift 2;; --llama-server) LS=$2; shift 2;; --dry-run) DRY=1; shift;; --no-pin) PIN=0; shift;; --no-ecores) ECORES=0; shift;; --open) OPEN=1; shift;; --load-method) METHOD=$2; shift 2;; --) shift; EXTRA=("$@"); break;;
  -h|--help) sed -n 2,6p "$0"; exit 0;; *) if [ -z "$MODEL" ]; then MODEL=$1; shift; else echo "unknown argument: $1"; exit 1; fi;; esac; done
[ -f "$MODEL" ] || { echo "usage: moe-cache-server MODEL.gguf [options]  (model file not found: '$MODEL')"; exit 1; }
LIB="${MOE_CACHE_LIB:-$HERE/build/libggml-moe-cache.so}"
[ -f "$LIB" ] || { echo "plugin not built: run ./build.sh first (looked for $LIB)"; exit 1; }
if [ -z "$NCMOE" ]; then
  P=("${MOE_CACHE_PYTHON:-python3}" "$HERE/planner/plan.py" "$MODEL" --ctx "$CTX" --json); [ -n "$RAM" ] && P+=(--ram-gib "$RAM"); [ -n "$VRAM" ] && P+=(--vram-gib "$VRAM")
  NCMOE=$("${P[@]}" 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["n_cpu_moe"])' 2>/dev/null || true)
  if [ -z "$NCMOE" ]; then echo "planner unavailable (needs python3 and 'pip install gguf'); keeping all experts on the CPU"; NCMOE=999; fi
fi
HOSTARG=""
for ((i = 0; i < ${#EXTRA[@]}; i++)); do if [ "${EXTRA[$i]}" = --host ]; then HOSTARG="${EXTRA[$((i + 1))]}"; fi; done
case "$HOSTARG" in ""|127.*|localhost|::1) ;; *)
  printf '%s ' "${EXTRA[@]}" | grep -q -- '--api-key' || echo "WARNING: llama-server will listen on '$HOSTARG' without --api-key: anyone who can reach this machine can use the model and the web UI. Add --api-key KEY after the -- or bind to 127.0.0.1." >&2;;
esac
case "$PNAME" in ""|*[!A-Za-z0-9_-]*) [ -z "$PNAME" ] || { echo "--profile NAME may only contain letters, digits, _ and -"; exit 1; };; esac
PROFILE="${XDG_CACHE_HOME:-$HOME/.cache}/moe-cache/$(basename "$MODEL").${PNAME:+$PNAME.}usage"
. "$HERE/bin/_moe_cache_env.sh"; moe_cache_load_env "$LS" "$LIB" "$METHOD"
ENVV=("${MOE_CACHE_LOAD[@]}" MOE_CACHE_SIZE_GIB=auto MOE_CACHE_GGUF="$MODEL" MOE_CACHE_PROFILE="$PROFILE")
[ -n "$RAM" ] && ENVV+=(MOE_CACHE_RAM_GIB="$RAM")
if [ $ECORES = 1 ] && [ -z "${MOE_CACHE_EXEC_ECORES:-}" ] && [ -r /sys/devices/cpu_atom/cpus ]; then
  NE=$(python3 -c 'import sys
n = 0
for part in open("/sys/devices/cpu_atom/cpus").read().strip().split(","):
    a, _, b = part.partition("-"); n += int(b or a) - int(a) + 1
print(min(n, 4))' 2>/dev/null || echo 0)
  [ "${NE:-0}" -gt 0 ] && ENVV+=(MOE_CACHE_EXEC_ECORES=$NE) && echo "moe-cache: expert executor will also use $NE efficiency cores (--no-ecores to disable)"
fi
PINARGS=()
if [ $PIN = 1 ] && [ -r /sys/devices/cpu_core/cpus ] && ! printf '%s ' "${EXTRA[@]}" | grep -qE -- '(^| )(-C|--cpu-mask|-Cr|--cpu-range)( |$)'; then
  MASK=$(python3 - <<'PYEOF' 2>/dev/null
def parse(t):
    r = []
    for part in t.strip().split(","):
        if "-" in part:
            a, b = part.split("-"); r += range(int(a), int(b) + 1)
        elif part: r.append(int(part))
    return r
p = parse(open("/sys/devices/cpu_core/cpus").read())
prim = [c for c in p if min(parse(open(f"/sys/devices/system/cpu/cpu{c}/topology/thread_siblings_list").read())) == c]
print(hex(sum(1 << c for c in prim)))
PYEOF
)
  [ -n "$MASK" ] && PINARGS=(-C "$MASK" --cpu-strict 1) && echo "moe-cache: hybrid CPU: pinning llama-server threads to the performance cores (-C $MASK); --no-pin to disable"
fi
# micro-batch size and GPU cache size: one shared tuner (bench/gguf_plan.py: tune) so the launcher and the benchmark tool decide the same way
TUNE_JSON=""
if [ "$UBARG" = auto ] || [ "$GCACHE" = auto ]; then
  TUNE_JSON=$("${MOE_CACHE_PYTHON:-python3}" - "$MODEL" "$CTX" "$GCACHE" "$VRAM" "$HERE" <<'PY' 2>/dev/null || true
import json, sys
sys.path.insert(0, sys.argv[5] + "/bench")
from gguf_plan import tune
free = float(sys.argv[4]) * 1e9 if sys.argv[4] else None
print(json.dumps(tune(sys.argv[1], int(sys.argv[2]), free=free, want_cache=sys.argv[3] != "off")))
PY
)
fi
if [ "$UBARG" = auto ]; then
  if printf '%s\n' "${EXTRA[@]}" | grep -q -- '^-ub$\|--ubatch-size'; then UBARG=""; else
    UBARG=$(printf '%s' "$TUNE_JSON" | python3 -c 'import sys,json; print(json.load(sys.stdin)["ub"])' 2>/dev/null || true)
  fi
fi
case "$UBARG" in ""|auto) ;; *[!0-9]*) echo "moe-cache: --ub must be auto or a number"; UBARG="";; *) EXTRA+=(-ub "$UBARG" -b 2048); echo "moe-cache: micro-batch -ub $UBARG (prompt processing; --ub N to change)";; esac
if [ "$GCACHE" != off ] && [ "$NCMOE" != 0 ]; then
  GCMIB="$GCACHE"
  if [ "$GCACHE" = auto ]; then
    GCMIB=$(printf '%s' "$TUNE_JSON" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d["gpu_cache_mib"] if d["gpu_cache_mib"] else "")' 2>/dev/null || true)
    [ -n "$TUNE_JSON" ] && printf '%s' "$TUNE_JSON" | python3 -c 'import sys,json; [print("moe-cache: tuner: " + w) for w in json.load(sys.stdin)["why"]]' 2>/dev/null
  fi
  case "$GCMIB" in ""|*[!0-9]*) echo "moe-cache: --gpu-cache: could not work out a size (planner unavailable?), using the planner's static GPU layers"; GCMIB="";; esac
  if [ -n "$GCMIB" ] && [ "$GCMIB" -lt 512 ]; then echo "moe-cache: --gpu-cache: only $GCMIB MiB of VRAM would be left, using the planner's static GPU layers"; GCMIB=""; fi
  if [ -n "$GCMIB" ]; then
    NCMOE=999; EXTRA+=(--moe-cache-mib "$GCMIB"); ENVV+=(MOE_CACHE_GPU_CACHE=1)
    echo "moe-cache: GPU expert cache of $GCMIB MiB; all experts are managed by the plugin (RAM) and the hottest ones are computed on the GPU"
  fi
fi
# llama-server saves finished prompts in host RAM (--cache-ram, 8 GiB by default). That memory competes with the expert cache and arrives in bursts, so it is
# capped at 2 GiB here (the plugin keeps the same amount free). Pass --cache-ram yourself to change it.
if "$LS" --help 2>/dev/null | grep -q -- '--cache-ram' && ! printf '%s\n' "${EXTRA[@]}" | grep -q -- '--cache-ram\|-cram'; then EXTRA+=(--cache-ram 2048); fi
CMD=("$LS" -m "$MODEL" -ngl 99 --n-cpu-moe "$NCMOE" -c "$CTX" -fa on --load-mode mmap --no-warmup --port "$PORT" "${PINARGS[@]}" "${EXTRA[@]}")
if [ "$NCMOE" = 0 ]; then echo "moe-cache: all experts fit in your GPU memory; the cache has nothing to manage for this model/context (profile $PROFILE; plugin loaded by $MOE_CACHE_METHOD)"
else echo "moe-cache: experts of $NCMOE layers stay on the CPU and are managed by the cache; profile $PROFILE; plugin loaded by $MOE_CACHE_METHOD"; fi
echo "moe-cache: web UI and API will be at http://localhost:$PORT"
if [ $DRY = 1 ]; then echo "env ${ENVV[*]} ${CMD[*]}"; exit 0; fi
if [ $OPEN = 1 ]; then ( for i in $(seq 600); do [ "$(curl -s -o /dev/null -w "%{http_code}" http://localhost:$PORT/health)" = 200 ] && { xdg-open "http://localhost:$PORT" >/dev/null 2>&1 || true; break; }; sleep 1; done ) & fi
exec env "${ENVV[@]}" "${CMD[@]}"
