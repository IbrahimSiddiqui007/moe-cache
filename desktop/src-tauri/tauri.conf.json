{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moe-cache",
  "version": "0.0.0",
  "identifier": "io.github.ibrahimsiddiqui007.moecache",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run big MoE models on a small computer",
    "resources": {
      "resources/moe-cache/": "moe-cache/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "6b1e0b8a-3c0d-4a54-9f2e-5d1a7c2b9e10"
      }
    }
  }
}
