diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/top_k_mask.comp b/ggml/src/ggml-vulkan/vulkan-shaders/top_k_mask.comp
new file mode 100644
index 000000000..77d5fbd1e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/top_k_mask.comp
@@ -0,0 +1,89 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#ifdef IS_F16
+#extension GL_EXT_shader_16bit_storage : require
+#endif
+
+#define BLOCK_SIZE 256
+
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+// all strides are in elements of the tensor's own type
+layout(push_constant) uniform parameter
+{
+    uint n_kv;
+    uint ne1, ne2;
+    uint mne1, mne2, mne3;          // mask extents (broadcast over the rows of dst)
+    uint mnb1, mnb2, mnb3;
+    uint n_top;
+    uint n_blk;
+    uint n_pick;
+    uint n_extra;
+    uint flags;                     // 1: score, 2: blocks, 4: extra
+    uint tnb0, tnb1, tnb2, tnb3;    // top_k
+    uint snb0, snb1, snb2, snb3;    // score
+    uint bnb0, bnb1;                // blocks
+    uint enb0, enb1, enb2, enb3;    // extra
+} p;
+
+layout (binding = 0) readonly  buffer M {M_TYPE data_m[];};
+layout (binding = 1) readonly  buffer T {int    data_t[];};
+layout (binding = 2) readonly  buffer S {float  data_s[];};
+layout (binding = 3) readonly  buffer B {int    data_b[];};
+layout (binding = 4) readonly  buffer E {int    data_e[];};
+layout (binding = 5) coherent writeonly buffer D {M_TYPE data_d[];};
+
+// dst row = mask row where a cell is picked, -inf elsewhere (GGML_OP_TOP_K_MASK, same as ggml_compute_forward_top_k_mask)
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint ir = gl_WorkGroupID.x;
+    const uint i1 = ir % p.ne1;
+    const uint i2 = (ir / p.ne1) % p.ne2;
+    const uint i3 = ir / (p.ne1 * p.ne2);
+
+    const uint m_row = (i1 % p.mne1) * p.mnb1 + (i2 % p.mne2) * p.mnb2 + (i3 % p.mne3) * p.mnb3;
+    const uint d_row = ir * p.n_kv;
+
+    for (uint c = tid; c < p.n_kv; c += BLOCK_SIZE) {
+        data_d[d_row + c] = NEG_INF;
+    }
+    // every -inf is written before any kept cell
+    memoryBarrierBuffer();
+    barrier();
+
+    const uint t_row = i1 * p.tnb1 + i2 * p.tnb2 + i3 * p.tnb3;
+    const bool has_score  = (p.flags & 1u) != 0u;
+    const bool has_blocks = (p.flags & 2u) != 0u;
+    const bool has_extra  = (p.flags & 4u) != 0u;
+
+    const uint total = p.n_top * p.n_blk;
+    for (uint idx = tid; idx < total; idx += BLOCK_SIZE) {
+        const uint j = idx / p.n_blk;
+        const uint k = idx - j * p.n_blk;
+        const int pick = data_t[t_row + j * p.tnb0];
+        if (pick < 0 || uint(pick) >= p.n_pick) {
+            continue;
+        }
+        if (has_score) {
+            const float s = data_s[uint(pick) * p.snb0 + i1 * p.snb1 + i2 * p.snb2 + i3 * p.snb3];
+            if (!(s > uintBitsToFloat(0xFF800000u))) {
+                continue;
+            }
+        }
+        const int c = has_blocks ? data_b[k * p.bnb0 + uint(pick) * p.bnb1] : pick;
+        if (c >= 0 && uint(c) < p.n_kv) {
+            data_d[d_row + uint(c)] = data_m[m_row + uint(c)];
+        }
+    }
+
+    if (has_extra) {
+        const uint e_row = i1 * p.enb1 + i2 * p.enb2 + i3 * p.enb3;
+        for (uint j = tid; j < p.n_extra; j += BLOCK_SIZE) {
+            const int c = data_e[e_row + j * p.enb0];
+            if (c >= 0 && uint(c) < p.n_kv) {
+                data_d[d_row + uint(c)] = data_m[m_row + uint(c)];
+            }
+        }
+    }
+}
