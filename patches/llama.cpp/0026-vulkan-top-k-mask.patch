+// GGML_OP_TOP_K_MASK: one workgroup per row of dst (GGML_VK_TOP_K_MASK=1)
+void ggml_vk_top_k_mask(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_tensor * dst) {
+    const ggml_tensor * mask   = dst->src[0];
+    const ggml_tensor * top_k  = dst->src[1];
+    const ggml_tensor * score  = dst->src[2];
+    const ggml_tensor * blocks = dst->src[3];
+    const ggml_tensor * extra  = dst->src[4];
+
+    GGML_ASSERT(dst->buffer != nullptr);
+
+    vk_pipeline pipeline = ggml_vk_op_get_pipeline(ctx, mask, top_k, score, dst, dst->op);
+    GGML_ASSERT(pipeline != nullptr);
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    const uint32_t ts = (uint32_t) ggml_type_size(mask->type);
+    const uint32_t n_rows = (uint32_t) ggml_nrows(dst);
+
+    vk_op_top_k_mask_push_constants pc = {};
+    pc.n_kv = (uint32_t) mask->ne[0];
+    pc.ne1 = (uint32_t) dst->ne[1];
+    pc.ne2 = (uint32_t) dst->ne[2];
+    pc.mne1 = (uint32_t) mask->ne[1]; pc.mne2 = (uint32_t) mask->ne[2]; pc.mne3 = (uint32_t) mask->ne[3];
+    pc.mnb1 = (uint32_t) (mask->nb[1] / ts); pc.mnb2 = (uint32_t) (mask->nb[2] / ts); pc.mnb3 = (uint32_t) (mask->nb[3] / ts);
+    pc.n_top = (uint32_t) top_k->ne[0];
+    pc.n_blk = blocks ? (uint32_t) blocks->ne[0] : 1;
+    pc.n_pick = blocks ? (uint32_t) blocks->ne[1] : score ? (uint32_t) score->ne[0] : pc.n_kv;
+    pc.n_extra = extra ? (uint32_t) extra->ne[0] : 0;
+    pc.flags = (score ? 1u : 0u) | (blocks ? 2u : 0u) | (extra ? 4u : 0u);
+    pc.tnb0 = (uint32_t) (top_k->nb[0] / 4); pc.tnb1 = (uint32_t) (top_k->nb[1] / 4); pc.tnb2 = (uint32_t) (top_k->nb[2] / 4); pc.tnb3 = (uint32_t) (top_k->nb[3] / 4);
+    if (score) {
+        pc.snb0 = (uint32_t) (score->nb[0] / 4); pc.snb1 = (uint32_t) (score->nb[1] / 4); pc.snb2 = (uint32_t) (score->nb[2] / 4); pc.snb3 = (uint32_t) (score->nb[3] / 4);
+    }
+    if (blocks) {
+        pc.bnb0 = (uint32_t) (blocks->nb[0] / 4); pc.bnb1 = (uint32_t) (blocks->nb[1] / 4);
+    }
+    if (extra) {
+        pc.enb0 = (uint32_t) (extra->nb[0] / 4); pc.enb1 = (uint32_t) (extra->nb[1] / 4); pc.enb2 = (uint32_t) (extra->nb[2] / 4); pc.enb3 = (uint32_t) (extra->nb[3] / 4);
+    }
+
+    vk_subbuffer m_buf = ggml_vk_tensor_subbuffer(ctx, mask);
+    vk_subbuffer opt[3] = { m_buf, m_buf, m_buf };     // absent inputs are bound to the mask, the shader does not read them
+    if (score)  { opt[0] = ggml_vk_tensor_subbuffer(ctx, score); }
+    if (blocks) { opt[1] = ggml_vk_tensor_subbuffer(ctx, blocks); }
+    if (extra)  { opt[2] = ggml_vk_tensor_subbuffer(ctx, extra); }
+
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        { m_buf, ggml_vk_tensor_subbuffer(ctx, top_k), opt[0], opt[1], opt[2], ggml_vk_tensor_subbuffer(ctx, dst) },
+        pc, { n_rows, 1, 1 });
+}
