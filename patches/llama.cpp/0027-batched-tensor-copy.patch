+static vk_context ggml_vk_begin_sync_ctx(vk_device & device, vk_command_pool & pool) {
+    vk_context subctx = ggml_vk_create_temporary_context(pool);
+    ggml_vk_ctx_begin(device, subctx);
+    return subctx;
