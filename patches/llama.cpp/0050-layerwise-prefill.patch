+llm_graph_result * llama_context::process_ubatch_lw(const llama_ubatch & ubatch, llama_memory_context_i * mctx, int32_t il0, int32_t il1,
+        const float * in, float * out, ggml_status & ret) {
+    auto * res = get_gf_res_prev();
+
+    // every segment has its own topology, and a stock graph must not take this one for the one it could reuse
+    gf_res_prev_active = nullptr;
+    res->reset();
+
+    ggml_backend_sched_reset(sched.get());
+    ggml_backend_sched_set_eval_callback(sched.get(), cparams.cb_eval, cparams.cb_eval_user_data);
+
+    auto gparams = graph_params(res, ubatch, mctx, ctx_type_to_graph_type(cparams.ctx_type));
+    gparams.lw_l0 = il0;
+    gparams.lw_l1 = il1;
+    gparams.lw_in = in;
+
+    int64_t t0 = ggml_time_us();
+    auto lap = [&](int i) {
+        const int64_t t1 = ggml_time_us();
+        lw_us[i] += t1 - t0;
+        t0 = t1;
+    };
+
+    auto * gf = model.build_graph(gparams);
+    if (!gf) {
+        LLAMA_LOG_ERROR("%s: failed to initialize graph\n", __func__);
+        ret = GGML_STATUS_FAILED;
+        return nullptr;
+    }
+    lap(0);
+
+    if (!ggml_backend_sched_alloc_graph(sched.get(), gf)) {
+        LLAMA_LOG_ERROR("%s: failed to allocate graph\n", __func__);
+        ret = GGML_STATUS_ALLOC_FAILED;
+        return nullptr;
+    }
+    lap(1);
+
+    res->set_inputs(&ubatch);
+    lap(2);
+
+    const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+    if (status != GGML_STATUS_SUCCESS) {
+        LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
+        ret = status;
+        return nullptr;
+    }
+
+    if (out) {
+        GGML_ASSERT(res->t_lw_out != nullptr);
+        // the buffer-level get does not wait for the (asynchronous) compute stream of a GPU backend: wait here
+        ggml_backend_sched_synchronize(sched.get());
+        lap(3);
+        ggml_backend_tensor_get(res->t_lw_out, out, 0, ggml_nbytes(res->t_lw_out));
+        lap(4);
+    } else {
+        lap(3);
+    }
+    lw_segments++;
+
+    ret = GGML_STATUS_SUCCESS;
+
+    return res;
+}
