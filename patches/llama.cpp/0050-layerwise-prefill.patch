+bool llama_kv_cache_context::lw_load(size_t i) {
+    if (i >= lw_saved.size()) {
+        return false;
+    }
+
+    i_cur = lw_saved[i].first;
+    n_kv  = lw_saved[i].second;
+
+    return true;
