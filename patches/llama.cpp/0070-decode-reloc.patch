+#include <chrono>
+#include <mutex>
+#include <thread>
+
+// number of live contexts per model: a second context (MTP / draft) shares the weights and keeps its own scheduler, so the move is refused
+static std::mutex & llama_reloc_mtx() { static std::mutex m; return m; }
+static std::unordered_map<const llama_model *, int> & llama_reloc_ctxs() { static std::unordered_map<const llama_model *, int> m; return m; }
+
+static int llama_reloc_live(const llama_model * m) {
+    std::lock_guard<std::mutex> lock(llama_reloc_mtx());
+    return llama_reloc_ctxs()[m];
+}
+
+// layout epoch per model: raised whenever expert tensors are moved or put back. A context whose scheduler was reserved under an older epoch holds
+// graphs that point at buffers which may be freed now, so it drops them before its next batch (a second context created while the layers were moved)
+static std::unordered_map<const llama_model *, uint64_t> & llama_reloc_epochs() { static std::unordered_map<const llama_model *, uint64_t> m; return m; }
+
+static uint64_t llama_reloc_epoch(const llama_model * m, bool bump) {
+    std::lock_guard<std::mutex> lock(llama_reloc_mtx());
+    uint64_t & e = llama_reloc_epochs()[m];
+    if (bump) {
+        e++;
+    }
+    return e;
+}
