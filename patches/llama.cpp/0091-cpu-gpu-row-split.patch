diff --git a/tests/test-cpu-gpu-split.cpp b/tests/test-cpu-gpu-split.cpp
new file mode 100644
index 0000000..6bd7da5
--- /dev/null
+++ b/tests/test-cpu-gpu-split.cpp
@@ -0,0 +1,129 @@
+// moe-cache patch 0091: the CPU + GPU row split of the decode mat-vec must give the same answer as the plain CPU path, for every row,
+// across share changes and a weight buffer that is freed and replaced. A second CPU backend plays the GPU (GGML_CPU_GPU_SPLIT_TEST=1),
+// so this runs without a GPU. Exit code 0 = pass.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+static int64_t (*ops_done)(void) = nullptr;
+
+static int g_fail = 0;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); g_fail++; } } while (0)
+
+// weights in a host buffer with the "weights" usage, like a loaded model's
+struct weights {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_tensor * w = nullptr;
+};
+
+static weights make_weights(ggml_type type, int64_t k, int64_t n, const std::vector<float> & data) {
+    weights r;
+    ggml_init_params ip = { ggml_tensor_overhead() * 4, nullptr, true };
+    r.ctx = ggml_init(ip);
+    r.w   = ggml_new_tensor_2d(r.ctx, type, k, n);
+    r.buf = ggml_backend_alloc_ctx_tensors_from_buft(r.ctx, ggml_backend_cpu_buffer_type());
+    ggml_backend_buffer_set_usage(r.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::vector<char> q(ggml_nbytes(r.w));
+    ggml_quantize_chunk(type, data.data(), q.data(), 0, n, k, nullptr);
+    ggml_backend_tensor_set(r.w, q.data(), 0, q.size());
+    return r;
+}
+
+static void free_weights(weights & r) {
+    ggml_backend_buffer_free(r.buf);
+    ggml_free(r.ctx);
+}
+
+// y = W x through the CPU backend graph (so the hook in ggml_compute_forward_mul_mat sees it)
+static std::vector<float> run(ggml_backend_t cpu, ggml_tensor * w, const std::vector<float> & x) {
+    ggml_init_params ip = { ggml_tensor_overhead() * 8 + ggml_graph_overhead() + 4096, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * xt = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, w->ne[0]);
+    ggml_tensor * y  = ggml_mul_mat(ctx, w, xt);
+    ggml_cgraph * g  = ggml_new_graph(ctx);
+    ggml_build_forward_expand(g, y);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_cpu_buffer_type());
+    ggml_backend_tensor_set(xt, x.data(), 0, x.size() * sizeof(float));
+    ggml_backend_graph_compute(cpu, g);
+    std::vector<float> out(w->ne[1]);
+    ggml_backend_tensor_get(y, out.data(), 0, out.size() * sizeof(float));
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    return out;
+}
+
+// float reference from the dequantised weights; tolerance covers the activation quantisation (Q8) of the CPU path
+static void compare(const char * what, ggml_tensor * w, const std::vector<float> & x, const std::vector<float> & y) {
+    const auto * tt = ggml_get_type_traits(w->type);
+    const int64_t k = w->ne[0], n = w->ne[1];
+    std::vector<char> raw(ggml_nbytes(w));
+    ggml_backend_tensor_get(w, raw.data(), 0, raw.size());
+    std::vector<float> row(k);
+    int bad = 0;
+    for (int64_t i = 0; i < n; i++) {
+        tt->to_float(raw.data() + i * w->nb[1], row.data(), k);
+        double ref = 0, mag = 0;
+        for (int64_t j = 0; j < k; j++) { ref += (double) row[j] * x[j]; mag += std::fabs((double) row[j] * x[j]); }
+        if (std::fabs(ref - y[i]) > 0.03 * mag + 1e-4) { if (bad++ < 3) printf("  %s row %lld: ref %g got %g\n", what, (long long) i, ref, y[i]); }
+    }
+    CHECK(bad == 0, "%s: %d of %lld rows differ from the reference", what, bad, (long long) n);
+}
+
+int main() {
+    setenv("GGML_CPU_GPU_SPLIT", "auto", 1);
+    setenv("GGML_CPU_GPU_SPLIT_TEST", "1", 1);
+    setenv("GGML_CPU_GPU_SPLIT_START", "0.3", 1);
+
+    ggml_backend_load_all();
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(cpu));
+    auto set_threads = (void (*)(ggml_backend_t, int)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+    ops_done = (int64_t (*)(void)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_gpu_split_ops_done");
+    if (!set_threads || !ops_done) { printf("FAIL: the CPU backend lacks the split entry points\n"); return 1; }
+    set_threads(cpu, 4);
+
+    const int64_t k = 1024, n = 4096;
+    std::mt19937 rng(1);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> data(k * n), x(k);
+    for (auto & v : data) v = nd(rng);
+    for (auto & v : x)    v = nd(rng);
+
+    for (ggml_type type : { GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K }) {
+        weights w = make_weights(type, k, n, data);
+        const int64_t before = ops_done();
+        // 300 ops: the automatic share moves (every 64 ops) and the plans are rebuilt; every answer must stay right
+        for (int i = 0; i < 300; i++) {
+            if (i % 50 == 0) {
+                for (auto & v : x) v = nd(rng);
+            }
+            std::vector<float> y = run(cpu, w.w, x);
+            if (i % 50 == 0 || i == 299) compare(ggml_type_name(type), w.w, x, y);
+        }
+        CHECK(ops_done() - before >= 250, "%s: the split ran %lld times (expected most of 300 ops)", ggml_type_name(type), (long long) (ops_done() - before));
+        free_weights(w);
+    }
+
+    // a freed and replaced weight buffer (a new model in the same process): same size, probably the same address, different values
+    {
+        weights a = make_weights(GGML_TYPE_Q4_0, k, n, data);
+        compare("before reload", a.w, x, run(cpu, a.w, x));
+        free_weights(a);
+        std::vector<float> data2(k * n);
+        for (auto & v : data2) v = nd(rng);
+        weights b = make_weights(GGML_TYPE_Q4_0, k, n, data2);
+        for (int i = 0; i < 3; i++) compare("after reload", b.w, x, run(cpu, b.w, x));
+        free_weights(b);
+    }
+
+    printf(g_fail ? "test-cpu-gpu-split: FAIL (%d)\n" : "test-cpu-gpu-split: PASS\n", g_fail);
+    ggml_backend_free(cpu);
+    return g_fail ? 1 : 0;
+}
