diff --git a/ggml/src/ggml-cpu/cpu-gpu-split.cpp b/ggml/src/ggml-cpu/cpu-gpu-split.cpp
new file mode 100644
index 0000000..55b281b
--- /dev/null
+++ b/ggml/src/ggml-cpu/cpu-gpu-split.cpp
@@ -0,0 +1,434 @@
+// CPU + GPU row split of the decode-time mat-vec on host-resident weights (moe-cache patch 0091).
+//
+// The CPU backend computes the first rows of a weight matrix, a GPU computes the last rows from the same host memory:
+// the weights are copied by DMA from page-locked memory (cudaHostRegister) into a small staging tensor on the GPU, the
+// mat-vec runs there, and the result comes back through a pinned bounce buffer. Both halves run at the same time, which
+// uses the PCIe bandwidth that the CPU decode leaves free. Whole thing is off unless GGML_CPU_GPU_SPLIT=<fraction> is set.
+
+#include "cpu-gpu-split.h"
+
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-impl.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <map>
+#include <utility>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace {
+
+bool g_dead = false;                 // set when the state is destroyed at exit: the free hook then does nothing
+thread_local bool t_freeing = false; // free_plans() is running on this thread: the buffers it frees are ours
+
+struct plan {
+    ggml_context *        ctx   = nullptr;
+    ggml_tensor *         w     = nullptr;
+    ggml_tensor *         x     = nullptr;
+    ggml_tensor *         out   = nullptr;
+    ggml_cgraph *         graph = nullptr;
+    ggml_backend_buffer_t buf   = nullptr;
+    ggml_backend_buffer_t wbuf  = nullptr; // zero-copy mode: the host rows imported as a GPU buffer
+    bool                  ok    = false;
+};
+
+struct pending {
+    plan *  p;
+    int64_t n_cpu;
+    int64_t n_gpu;
+};
+
+struct state {
+    bool                  enabled  = false;
+    bool                  stats    = false;
+    bool                  serial   = false; // debug: wait for the GPU inside begin() to time the GPU path alone
+    double                t_gpu_us = 0, gpu_bytes = 0;
+    double                frac     = 0.0;
+    bool                  autoratio = false;  // GGML_CPU_GPU_SPLIT=auto: the share follows the measured wait
+    int                   win_ops  = 0;
+    double                win_cpu_us = 0, win_wait_us = 0;
+    int                   hold     = 0;       // windows during which the share may not grow (after a decrease)
+    int64_t               min_rows = 1024;
+    ggml_backend_t        gpu      = nullptr;
+    ggml_backend_dev_t    dev      = nullptr;
+    bool                  zero     = false;   // zero-copy: the GPU reads the host weight rows in place (host-pointer import), no copy. Used where the backend cannot page-lock (Vulkan)
+    bool                (*reg_host)(void *, size_t) = nullptr;
+    void                (*unreg_host)(void *) = nullptr;
+    bool                  test_mode = false; // GGML_CPU_GPU_SPLIT_TEST=1: a second CPU backend plays the GPU (CI has none)
+    ggml_backend_buffer_t bounce   = nullptr;
+    char *                bounce_x = nullptr;
+    char *                bounce_o = nullptr;
+    size_t                bounce_half = 0;
+
+    std::unordered_map<ggml_backend_buffer_t, bool> registered; // buffer -> registered ok
+    std::unordered_map<uint64_t, plan>              plans;
+    std::map<std::pair<const void *, int64_t>, plan> zplans;   // zero-copy: one plan per weight tensor (the GPU reads that tensor's rows)
+
+    pending cur;
+
+    // stats
+    int64_t n_ops = 0;
+    double  t_begin_us = 0, t_wait_us = 0, t_cpu_us = 0;
+    std::chrono::steady_clock::time_point t_mark;
+
+    ~state() {
+        g_dead = true;
+        if (stats && n_ops > 0) {
+            fprintf(stderr, "cpu_gpu_split: ops %lld, final frac %.3f, begin %.1f us/op, cpu rows %.1f us/op, gpu wait after cpu done %.1f us/op\n",
+                    (long long) n_ops, frac, t_begin_us / n_ops, t_cpu_us / n_ops, t_wait_us / n_ops);
+            if (serial) {
+                fprintf(stderr, "cpu_gpu_split: serial GPU path %.1f us/op, %.2f GB/s of weights\n", t_gpu_us / n_ops, gpu_bytes / t_gpu_us / 1e3);
+            }
+        }
+    }
+};
+
+state & st() {
+    static state s;
+    return s;
+}
+
+std::once_flag g_once;
+std::mutex     g_mutex;     // the maps and the share
+std::mutex     g_inflight;  // one split op at a time over the whole process (bounce buffers, pending slot)
+
+void free_hook(ggml_backend_buffer_t buffer);
+
+void init() {
+    state & s = st();
+    const char * e = getenv("GGML_CPU_GPU_SPLIT");
+    if (!e || !*e) {
+        return;
+    }
+    const bool is_auto = strcmp(e, "auto") == 0;
+    double f = is_auto ? 0.30 : atof(e);
+    if (is_auto) {
+        const char * st0 = getenv("GGML_CPU_GPU_SPLIT_START");
+        if (st0 && atof(st0) > 0.0 && atof(st0) < 1.0) {
+            f = atof(st0);
+        }
+    }
+    if (!(f > 0.0 && f < 1.0)) {
+        return;
+    }
+    s.autoratio = is_auto;
+    const char * m = getenv("GGML_CPU_GPU_SPLIT_MIN_ROWS");
+    if (m && *m) {
+        s.min_rows = atoll(m);
+    }
+    s.stats  = getenv("GGML_CPU_GPU_SPLIT_STATS") != nullptr;
+    s.serial = getenv("GGML_CPU_GPU_SPLIT_SERIAL") != nullptr;
+
+    if (getenv("GGML_CPU_GPU_SPLIT_TEST")) {
+        // the rows of the "GPU" are computed by a second, single-thread CPU backend: tests the bookkeeping without a GPU
+        s.gpu = ggml_backend_cpu_init();
+        ggml_backend_cpu_set_n_threads(s.gpu, 1);
+        ggml_backend_buffer_type_t cb = ggml_backend_cpu_buffer_type();
+        s.bounce_half = 4u << 20;
+        s.bounce = ggml_backend_buft_alloc_buffer(cb, 2 * s.bounce_half);
+        s.bounce_x = (char *) ggml_backend_buffer_get_base(s.bounce);
+        s.bounce_o = s.bounce_x + s.bounce_half;
+        s.reg_host = [](void *, size_t) { return true; };
+        s.unreg_host = [](void *) {};
+        s.test_mode = true;
+        s.enabled = true;
+        s.frac = f;
+        ggml_backend_buffer_set_free_hook(free_hook);
+        return;
+    }
+    // the first GPU the registry saw (the CPU backend cannot call the registry: on Windows it lives in another library)
+    for (ggml_backend_dev_t dev = ggml_backend_get_split_device(); dev != nullptr; dev = nullptr) {
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        auto fn = (bool (*)(void *, size_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer");
+        ggml_backend_buffer_type_t hbuft = ggml_backend_dev_host_buffer_type(dev);
+        struct ggml_backend_dev_props props;
+        ggml_backend_dev_get_props(dev, &props);
+        // CUDA: page-lock the weights and copy the GPU's rows by DMA. Vulkan (no page-locking call; copies cost 30-37 % on the PC): import the host rows as a GPU buffer and read them in place.
+        const bool by_import = !fn && hbuft && strstr(ggml_backend_dev_name(dev), "Vulkan") != nullptr;
+        if (!hbuft || (!fn && !by_import)) {
+            continue; // this backend cannot pin or import host memory
+        }
+        s.zero = by_import;
+        s.dev  = dev;
+        ggml_backend_t be = ggml_backend_dev_init(dev, nullptr);
+        if (!be) {
+            continue;
+        }
+        s.bounce_half = 4u << 20;
+        s.bounce = ggml_backend_buft_alloc_buffer(hbuft, 2 * s.bounce_half);
+        if (!s.bounce) {
+            ggml_backend_free(be);
+            continue;
+        }
+        s.bounce_x = (char *) ggml_backend_buffer_get_base(s.bounce);
+        s.bounce_o = s.bounce_x + s.bounce_half;
+        s.gpu      = be;
+        s.reg_host = fn;
+        s.unreg_host = (void (*)(void *)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer");
+        ggml_backend_buffer_set_free_hook(free_hook);
+        s.enabled  = true;
+        fprintf(stderr, "cpu_gpu_split: on, GPU share %.3f of the rows, device %s, %s\n", f, ggml_backend_dev_name(dev), s.zero ? "zero-copy (host rows read in place)" : "DMA from page-locked RAM");
+        s.frac = f;
+        return;
+    }
+    fprintf(stderr, "cpu_gpu_split: GGML_CPU_GPU_SPLIT set but no usable GPU backend; split off\n");
+}
+
+bool eligible(const ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    if (dst->op != GGML_OP_MUL_MAT || !a || !b) return false;
+    if (b->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (b->ne[1] != 1 || b->ne[2] != 1 || b->ne[3] != 1 || a->ne[2] != 1 || a->ne[3] != 1) return false;
+    if (!ggml_is_contiguous(a) || !ggml_is_contiguous(b) || !ggml_is_contiguous(dst)) return false;
+    if (a->ne[1] < st().min_rows) return false;
+    if (a->buffer == nullptr || a->view_src != nullptr) return false;
+    // plain host weights only (not a repacked or other extra buffer type)
+    if (!ggml_backend_buffer_is_host(a->buffer) || strstr(ggml_backend_buffer_name(a->buffer), "REPACK") != nullptr) return false;
+    if (ggml_backend_buffer_get_usage(a->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) return false;
+    if (ggml_is_quantized(a->type) && a->ne[0] % ggml_blck_size(a->type) != 0) return false;
+    return true;
+}
+
+int64_t gpu_rows_for(const ggml_tensor * dst) {
+    const int64_t n  = dst->src[0]->ne[1];
+    int64_t       ng = (int64_t) (st().frac * (double) n);
+    ng -= ng % 32;
+    return ng > 0 && ng < n ? ng : 0;
+}
+
+plan * get_plan_zero(const ggml_tensor * a, int64_t ng) {
+    state & s = st();
+    const auto zkey = std::make_pair((const void *) a->data, ng);
+    auto it = s.zplans.find(zkey);
+    if (it != s.zplans.end()) {
+        return &it->second;
+    }
+    plan & p = s.zplans[zkey];
+    const int64_t nc  = a->ne[1] - ng;
+    char *        beg = (char *) a->data + (size_t) nc * a->nb[1];
+    const size_t  len = (size_t) ng * a->nb[1];
+    // the import must start and end on page boundaries: round outwards (the extra bytes are valid memory of this process, only read)
+    uintptr_t lo = 0;
+    for (const size_t page : { (size_t) 4096, (size_t) 65536 }) {
+        lo = (uintptr_t) beg & ~(uintptr_t) (page - 1);
+        const uintptr_t hi = ((uintptr_t) beg + len + page - 1) & ~(uintptr_t) (page - 1);
+        p.wbuf = ggml_backend_dev_buffer_from_host_ptr(s.dev, (void *) lo, hi - lo, hi - lo);
+        if (p.wbuf) break;
+    }
+    ggml_init_params ip = { ggml_tensor_overhead() * 8 + ggml_graph_overhead() + 4096, nullptr, true };
+    p.ctx = ggml_init(ip);
+    p.w   = ggml_new_tensor_2d(p.ctx, a->type, a->ne[0], ng);
+    p.x   = ggml_new_tensor_1d(p.ctx, GGML_TYPE_F32, a->ne[0]);
+    p.out = ggml_mul_mat(p.ctx, p.w, p.x);
+    p.graph = ggml_new_graph(p.ctx);
+    ggml_build_forward_expand(p.graph, p.out);
+    if (!p.wbuf || !ggml_backend_supports_op(s.gpu, p.out) || (size_t) (a->ne[0] * 4) > s.bounce_half || (size_t) (ng * 4) > s.bounce_half) {
+        if (!p.wbuf) fprintf(stderr, "cpu_gpu_split: cannot import host memory into the GPU; no split for this tensor\n");
+        return &p;
+    }
+    // device buffers have their own address space: the tensor sits at the buffer's base plus its offset inside the imported range
+    ggml_backend_tensor_alloc(p.wbuf, p.w, (char *) ggml_backend_buffer_get_base(p.wbuf) + ((uintptr_t) beg - lo));
+    p.buf = ggml_backend_alloc_ctx_tensors_from_buft(p.ctx, ggml_backend_get_default_buffer_type(s.gpu));
+    p.ok  = p.buf != nullptr;
+    return &p;
+}
+
+plan * get_plan(const ggml_tensor * a, int64_t ng) {
+    state & s = st();
+    if (s.zero) {
+        return get_plan_zero(a, ng);
+    }
+    const uint64_t key = ((uint64_t) a->type << 56) ^ ((uint64_t) a->ne[0] << 28) ^ (uint64_t) ng;
+    auto it = s.plans.find(key);
+    if (it != s.plans.end()) {
+        return &it->second;
+    }
+    plan & p = s.plans[key];
+    ggml_init_params ip = { ggml_tensor_overhead() * 8 + ggml_graph_overhead() + 4096, nullptr, true };
+    p.ctx   = ggml_init(ip);
+    p.w     = ggml_new_tensor_2d(p.ctx, a->type, a->ne[0], ng);
+    p.x     = ggml_new_tensor_1d(p.ctx, GGML_TYPE_F32, a->ne[0]);
+    ggml_tensor * mm = ggml_mul_mat(p.ctx, p.w, p.x);
+    p.out   = mm;
+    p.graph = ggml_new_graph(p.ctx);
+    ggml_build_forward_expand(p.graph, mm);
+    if (!ggml_backend_supports_op(s.gpu, mm) || (size_t) (a->ne[0] * 4) > s.bounce_half || (size_t) (ng * 4) > s.bounce_half) {
+        return &p; // ok = false
+    }
+    ggml_backend_buffer_type_t gbuft = ggml_backend_get_default_buffer_type(s.gpu);
+    p.buf = ggml_backend_alloc_ctx_tensors_from_buft(p.ctx, gbuft);
+    p.ok  = p.buf != nullptr;
+    return &p;
+}
+
+void free_plans() {
+    state & s = st();
+    t_freeing = true;
+    ggml_backend_synchronize(s.gpu);
+    for (auto & kv : s.plans) {
+        if (kv.second.buf) ggml_backend_buffer_free(kv.second.buf);
+        if (kv.second.ctx) ggml_free(kv.second.ctx);
+    }
+    s.plans.clear();
+    for (auto & kv : s.zplans) {
+        if (kv.second.buf) ggml_backend_buffer_free(kv.second.buf);
+        if (kv.second.wbuf) ggml_backend_buffer_free(kv.second.wbuf);
+        if (kv.second.ctx) ggml_free(kv.second.ctx);
+    }
+    s.zplans.clear();
+    t_freeing = false;
+}
+
+// auto mode: every 64 ops compare the time the CPU waited for the GPU after it finished its own rows (wait) with its own
+// compute time. wait above 5 % of the CPU time -> the GPU is the slower half, give it less; wait below 1 % -> the GPU
+// is idle part of the time, give it more (but not right after a decrease). Steps of 0.025, share kept in 0.05..0.60.
+void adapt(double cpu_us, double wait_us) {
+    state & s = st();
+    s.win_ops++; s.win_cpu_us += cpu_us; s.win_wait_us += wait_us;
+    if (s.win_ops < 64) {
+        return;
+    }
+    const double r = s.win_wait_us / (s.win_cpu_us > 1.0 ? s.win_cpu_us : 1.0);
+    double f = s.frac;
+    if (r > 0.05) {
+        f -= 0.025; s.hold = 4;
+    } else if (r < 0.01 && s.hold == 0) {
+        f += 0.025;
+    }
+    if (s.hold > 0 && r <= 0.05) s.hold--;
+    f = f < 0.05 ? 0.05 : (f > 0.60 ? 0.60 : f);
+    s.win_ops = 0; s.win_cpu_us = 0; s.win_wait_us = 0;
+    if (f != s.frac) {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        s.frac = f;
+        free_plans(); // staging tensors are sized for the share; the next op builds the new ones
+    }
+}
+
+bool ensure_registered(const ggml_tensor * a) {
+    state & s = st();
+    if (s.zero) {
+        return true;
+    }
+    auto it = s.registered.find(a->buffer);
+    if (it != s.registered.end()) {
+        return it->second;
+    }
+    if (strstr(ggml_backend_buffer_name(a->buffer), "Host") != nullptr) { // already page-locked by the GPU backend
+        s.registered[a->buffer] = true;
+        return true;
+    }
+    void * base = ggml_backend_buffer_get_base(a->buffer);
+    size_t size = ggml_backend_buffer_get_size(a->buffer);
+    const bool ok = s.reg_host(base, size);
+    s.registered[a->buffer] = ok;
+    if (!ok) {
+        fprintf(stderr, "cpu_gpu_split: cannot page-lock the weight buffer (%.1f MiB); no split for tensors in it\n", size / 1048576.0);
+    }
+    return ok;
+}
+
+// A weight buffer is going away (model unloaded or replaced): forget the page-lock and every plan that may point into it, because a
+// later buffer can get the same address.
+void free_hook(ggml_backend_buffer_t buffer) {
+    if (g_dead || t_freeing || !ggml_backend_buffer_is_host(buffer)) {
+        return;
+    }
+    state & s = st();
+    if (!s.enabled) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock_op(g_inflight); // lock order everywhere: g_inflight, then g_mutex; not in the middle of a split op
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = s.registered.find(buffer);
+    if (it == s.registered.end() && !s.zero) {
+        return;
+    }
+    if (it != s.registered.end()) {
+        if (it->second && s.unreg_host && strstr(ggml_backend_buffer_name(buffer), "Host") == nullptr) {
+            s.unreg_host(ggml_backend_buffer_get_base(buffer));
+        }
+        s.registered.erase(it);
+    }
+    free_plans();
+}
+
+} // namespace
+
+extern "C" int64_t ggml_cpu_gpu_split_rows(const struct ggml_tensor * dst) {
+    std::call_once(g_once, init);
+    if (!st().enabled || !eligible(dst)) {
+        return 0;
+    }
+    const int64_t ng = gpu_rows_for(dst);
+    if (ng == 0) {
+        return 0;
+    }
+    // all fallible setup happens here, so every thread gets the same answer
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!ensure_registered(dst->src[0])) {
+        return 0;
+    }
+    return get_plan(dst->src[0], ng)->ok ? ng : 0;
+}
+
+extern "C" void * ggml_cpu_gpu_split_begin(const struct ggml_tensor * dst, int64_t ng) {
+    state & s = st();
+    g_inflight.lock(); // released in finish() by the same thread
+    std::lock_guard<std::mutex> lock(g_mutex);
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    const auto t0 = std::chrono::steady_clock::now();
+
+    plan * p = get_plan(a, ng);
+    if (!p->ok || (!s.zero && !ensure_registered(a))) {
+        // the other threads already left these rows out, and a plan that was fine a moment ago could not be rebuilt (memory)
+        GGML_ABORT("cpu_gpu_split: cannot start the GPU rows of an op the other threads already skipped");
+    }
+    const int64_t nc = a->ne[1] - ng;
+
+    memcpy(s.bounce_x, b->data, ggml_nbytes(b));
+    ggml_backend_tensor_set_async(s.gpu, p->x, s.bounce_x, 0, ggml_nbytes(b));
+    if (!s.zero) {
+        ggml_backend_tensor_set_async(s.gpu, p->w, (const char *) a->data + (size_t) nc * a->nb[1], 0, (size_t) ng * a->nb[1]);
+    }
+    GGML_ASSERT(ggml_backend_graph_compute_async(s.gpu, p->graph) == GGML_STATUS_SUCCESS);
+    ggml_backend_tensor_get_async(s.gpu, p->out, s.bounce_o, 0, (size_t) ng * sizeof(float));
+
+    if (s.serial) {
+        ggml_backend_synchronize(s.gpu);
+        s.t_gpu_us  += std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count();
+        s.gpu_bytes += (double) ng * a->nb[1];
+    }
+    s.cur = { p, nc, ng };
+    s.t_mark = std::chrono::steady_clock::now();
+    s.t_begin_us += std::chrono::duration<double, std::micro>(s.t_mark - t0).count();
+    return &s.cur;
+}
+
+extern "C" int64_t ggml_cpu_gpu_split_ops_done(void) {
+    return st().n_ops;
+}
+
+extern "C" void ggml_cpu_gpu_split_finish(struct ggml_tensor * dst, void * handle) {
+    state & s = st();
+    pending * pd = (pending *) handle;
+    const auto t1 = std::chrono::steady_clock::now();
+    ggml_backend_synchronize(s.gpu);
+    const auto t2 = std::chrono::steady_clock::now();
+    memcpy((float *) dst->data + pd->n_cpu, s.bounce_o, (size_t) pd->n_gpu * sizeof(float));
+    s.n_ops++;
+    const double cpu_us  = std::chrono::duration<double, std::micro>(t1 - s.t_mark).count();
+    const double wait_us = std::chrono::duration<double, std::micro>(t2 - t1).count();
+    s.t_cpu_us  += cpu_us;
+    s.t_wait_us += wait_us;
+    if (s.autoratio) {
+        adapt(cpu_us, wait_us);
+    }
+    g_inflight.unlock();
+}
