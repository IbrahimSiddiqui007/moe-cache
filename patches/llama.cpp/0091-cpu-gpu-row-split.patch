+#pragma once
+
+// Optional CPU + GPU row split of the decode-time mat-vec on host-resident weights (moe-cache patch 0091).
+// Off unless GGML_CPU_GPU_SPLIT=<fraction of rows for the GPU, 0..1> is set.
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Called by thread 0 of the CPU backend before it computes `dst` (a MUL_MAT), with the n_gpu that ggml_cpu_gpu_split_rows()
+// returned to all threads for this op. Starts the GPU half of exactly those rows (the last ones) and returns a handle for
+// ggml_cpu_gpu_split_finish(). One op at a time over the whole process: a second context waits here.
+void * ggml_cpu_gpu_split_begin(const struct ggml_tensor * dst, int64_t n_gpu);
+
+// number of ops split so far (tests)
+int64_t ggml_cpu_gpu_split_ops_done(void);
+
+// Called by thread 0 after the CPU finished its rows: waits for the GPU and writes its rows into dst.
+void ggml_cpu_gpu_split_finish(struct ggml_tensor * dst, void * handle);
+
+// Cheap check used by all threads (same answer as begin() would give for "split or not", before any state changes).
+int64_t ggml_cpu_gpu_split_rows(const struct ggml_tensor * dst);
+
+#ifdef __cplusplus
+}
+#endif
