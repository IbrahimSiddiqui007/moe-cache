+static void ggml_compute_forward_mul_mat_rows(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst);
+
+// moe-cache 0091: optional CPU + GPU row split of the decode mat-vec (GGML_CPU_GPU_SPLIT, off by default)
 void ggml_compute_forward_mul_mat(
         const struct ggml_compute_params * params,
               struct ggml_tensor * dst) {
+    const int64_t n_gpu = ggml_cpu_gpu_split_rows(dst);
+    if (n_gpu == 0) {
+        ggml_compute_forward_mul_mat_rows(params, dst);
+        return;
+    }
+
+    void * handle = NULL;
+    if (params->ith == 0) {
+        // cannot fail: everything that can fail was checked in ggml_cpu_gpu_split_rows()
+        GGML_ASSERT(ggml_cpu_gpu_split_begin(dst, &handle) == n_gpu);
+    }
+
+    // the CPU computes the first rows; src0 and dst are shortened in local copies
+    struct ggml_tensor src0_cpu = *dst->src[0];
+    struct ggml_tensor dst_cpu  = *dst;
+    src0_cpu.ne[1]  = dst->src[0]->ne[1] - n_gpu;
+    dst_cpu.ne[0]   = src0_cpu.ne[1];
+    dst_cpu.src[0]  = &src0_cpu;
+    ggml_compute_forward_mul_mat_rows(params, &dst_cpu);
+
+    if (handle) {
+        ggml_cpu_gpu_split_finish(dst, handle);
+    }
+}
