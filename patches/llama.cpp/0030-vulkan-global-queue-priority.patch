diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 44e2d7b14..8568c1a37 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4793,12 +4793,61 @@ vk_device ggml_vk_get_device(size_t idx) {
 #endif
         device->name = GGML_VK_NAME + std::to_string(idx);
 
+        // moe-cache patch 0030: GGML_VK_GLOBAL_PRIORITY = low | medium | high asks the driver to schedule this process's
+        // queues ahead of (or behind) other programs' GPU work (VK_KHR_global_priority). Unset = unchanged. If the driver refuses
+        // (for example "high" can need extra rights), the device is created the normal way and a line is printed.
+        VkQueueGlobalPriorityKHR global_prio = VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR;
+        bool want_global_prio = false;
+        if (const char * e = getenv("GGML_VK_GLOBAL_PRIORITY")) {
+            bool known = true;
+            if (strcmp(e, "low") == 0)           { global_prio = VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR; }
+            else if (strcmp(e, "medium") == 0)   { global_prio = VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR; }
+            else if (strcmp(e, "high") == 0)     { global_prio = VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR; }
+            else { known = false; GGML_LOG_WARN("ggml_vulkan: GGML_VK_GLOBAL_PRIORITY=%s ignored (low, medium, high)\n", e); }
+            if (known) {
+                bool have_ext = false;
+                for (const auto & ext : ext_props) {
+                    have_ext = have_ext || strcmp("VK_KHR_global_priority", ext.extensionName) == 0;
+                }
+                want_global_prio = have_ext;
+                if (!have_ext) {
+                    GGML_LOG_WARN("ggml_vulkan: GGML_VK_GLOBAL_PRIORITY ignored: the driver has no VK_KHR_global_priority\n");
+                }
+            }
+        }
+        VkDeviceQueueGlobalPriorityCreateInfoKHR global_prio_info {};
+        global_prio_info.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_KHR;
+        global_prio_info.globalPriority = global_prio;
+        if (want_global_prio) {
+            for (auto & qci : device_queue_create_infos) {
+                qci.setPNext(&global_prio_info);
+            }
+            device_extensions.push_back("VK_KHR_global_priority");
+        }
+
         device_create_info
             .setFlags(vk::DeviceCreateFlags())
             .setQueueCreateInfos(device_queue_create_infos)
             .setPEnabledExtensionNames(device_extensions);
         device_create_info.setPNext(&device_features2);
-        device->device = device->physical_device.createDevice(device_create_info);
+        try {
+            device->device = device->physical_device.createDevice(device_create_info);
+        } catch (const vk::SystemError & err) {
+            if (!want_global_prio) {
+                throw;
+            }
+            GGML_LOG_WARN("ggml_vulkan: GGML_VK_GLOBAL_PRIORITY refused by the driver (%s), using the default priority\n", err.what());
+            for (auto & qci : device_queue_create_infos) {
+                qci.setPNext(nullptr);
+            }
+            device_extensions.pop_back();
+            device_create_info.setPEnabledExtensionNames(device_extensions);
+            device->device = device->physical_device.createDevice(device_create_info);
+            want_global_prio = false;
+        }
+        if (want_global_prio) {
+            GGML_LOG_INFO("ggml_vulkan: queue global priority %s\n", getenv("GGML_VK_GLOBAL_PRIORITY"));
+        }
 
         if (device->device_fault) {
             device->pfn_vkGetDeviceFaultInfoEXT = (PFN_vkGetDeviceFaultInfoEXT)
