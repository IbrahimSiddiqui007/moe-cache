diff --git b/docs/CONFIGURATION.md a/docs/CONFIGURATION.md
index 603e247..df48c0e 100644
--- b/docs/CONFIGURATION.md
+++ a/docs/CONFIGURATION.md
@@ -107,6 +107,7 @@ The table above is the short list. This part covers the remaining `MOE_CACHE_*`
 | `MOE_CACHE_POOL_TINY` | When on, a job of a single chunk runs directly on the calling thread, with no wake-up of the worker threads. Set `0` (or `off`/`false`/`no`) to turn that shortcut off. | On | internal/testing |
 | `MOE_CACHE_PREFILL_LEND_MIB` | While a long prompt is processed, the expert cache gives this many MiB back to the system and takes them back when generation starts. Prints a message when it happens. | 0 (off) | advanced |
 | `MOE_CACHE_PRELOAD` | Set to `1` by the launcher together with `LD_PRELOAD` when the plugin is loaded that way; the plugin reads it to know it was preloaded. The GPU cache option needs it. Do not set it by hand. | Off | set by the launcher |
+| `MOE_CACHE_PRELOAD_SKIP_TOKENS` | If the very first batch the model processes has at least this many tokens, the startup fill of the cache is skipped, since that prompt will read most experts anyway. The batch is at most the micro-batch size (`-ub`), so a value above `-ub` never triggers. 0 or less means never skip. | 0 (off) | advanced |
 | `MOE_CACHE_PROBE_CACHE` | Only when exactly `1`: the launcher saves the Vulkan GPU limits it measures in a file (keyed by device names and the llama-server file size and date), so a restart skips the measurement. | Off | advanced |
 | `MOE_CACHE_PROC_PRIO` | Windows only (does nothing elsewhere). Any value starting with `h` raises the process CPU priority to High; any other non-empty value raises it to Above Normal. Prints whether Windows accepted it. | Off (priority unchanged) | advanced |
 | `MOE_CACHE_PROFILE_DECAY` | A number from 0 to 1: how much of the previously learned expert-usage profile is kept when it is combined with this session's usage when the profile is saved (0 forgets old usage, 1 keeps it fully). Bad values are ignored with a warning. | 0.5 | advanced |
diff --git b/src/mc_compute.inl a/src/mc_compute.inl
index 3c3c791..3210435 100644
--- b/src/mc_compute.inl
+++ a/src/mc_compute.inl
@@ -431,7 +431,23 @@ enum ggml_status be_compute(ggml_backend_t backend, ggml_cgraph * cg) {
 #ifdef _WIN32
             s.release_model_pages();
 #endif
-            s.preload();
+            // idea C20 (MOE_CACHE_PRELOAD_SKIP_TOKENS=N, default off): a first graph of N or more tokens is a long cold prefill that reads nearly every
+            // expert itself, so the startup fill is skipped instead of read twice / displaced; the cache then fills from the prompt
+            static const int skip_tok = getenv("MOE_CACHE_PRELOAD_SKIP_TOKENS") ? atoi(getenv("MOE_CACHE_PRELOAD_SKIP_TOKENS")) : 0;
+            bool skip_preload = false;
+            if (skip_tok > 0) {
+                const int nn = ggml_graph_n_nodes(cg);
+                for (int i = 0; i < nn && !skip_preload; i++) {
+                    const ggml_tensor * q = ggml_graph_node(cg, i);
+                    skip_preload = q->op == GGML_OP_MUL_MAT_ID && q->src[2] && q->src[2]->ne[1] >= skip_tok;
+                }
+            }
+            if (skip_preload) {
+                s.preload_done = true;
+                fprintf(stderr, "moe-cache: the first graph is a long prompt (>= %d tokens): the startup fill is skipped (MOE_CACHE_PRELOAD_SKIP_TOKENS)\n", skip_tok);
+            } else {
+                s.preload();
+            }
             s.drop_readahead();      // CACHE-058 (MOE_CACHE_DROP_READAHEAD=1, default off)
         }
         static const bool lend_on = getenv("MOE_CACHE_PREFILL_LEND_MIB") != nullptr;
