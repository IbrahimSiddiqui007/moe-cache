--- b/bin/moe_cache.py
+++ a/bin/moe_cache.py
@@ -774,12 +774,35 @@ def vk_cache_cap(ls, model, listing=None):
     vkdevs = [n.strip() for n in re.findall(r"^\s+Vulkan\d+: (.+?) \(\d+ MiB", listing or list_devices(ls), re.M)]
     if not vkdevs:
         return None, None
+    # idea L03 (MOE_CACHE_PROBE_CACHE=1, default off): the device limits are kept in a file by device names and llama-server file (size + date), so a restart
+    # does not run the probe again; any change of device list or binary reads them fresh
+    pc_file = os.path.join(CACHE_DIR, "vk_limits.json")
     try:
+        st_ls = os.stat(ls)
+        pc_key = "|".join(sorted(vkdevs)) + f"|{st_ls.st_size}|{int(st_ls.st_mtime)}"
+    except OSError:
+        pc_key = None
+    lim = None
+    if os.environ.get("MOE_CACHE_PROBE_CACHE") == "1" and pc_key:
+        try:
+            lim = json.load(open(pc_file)).get(pc_key)
+        except (OSError, ValueError):
+            lim = None
+    if lim is None:
+      try:
         r = subprocess.run([python_cmd(), "-c", "import json, sys; sys.path.insert(0, sys.argv[1]); import moe_cache as m; print(json.dumps(m.vk_tensor_limits()))",
                             os.path.join(HERE, "bin")], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=60,
                            creationflags=0x08000000 if WINDOWS else 0)          # CREATE_NO_WINDOW: no console flash under pythonw
         lim = json.loads(r.stdout.strip().splitlines()[-1])
-    except Exception:
+        if os.environ.get("MOE_CACHE_PROBE_CACHE") == "1" and pc_key and lim:
+            try:
+                d = json.load(open(pc_file)) if os.path.isfile(pc_file) else {}
+                d[pc_key] = lim
+                os.makedirs(CACHE_DIR, exist_ok=True)
+                write_text_atomic(pc_file, json.dumps(d))
+            except (OSError, ValueError):
+                pass
+      except Exception:
         lim = []
     match = [b for n, b in lim if n.strip() in vkdevs] or [b for n, b in lim]     # the listed devices by name, else all
     if not match:
diff --git b/docs/CONFIGURATION.md a/docs/CONFIGURATION.md
index 97bf72b..4424410 100644
--- b/docs/CONFIGURATION.md
+++ a/docs/CONFIGURATION.md
@@ -100,6 +100,7 @@ The table above is the short list. This part covers the remaining `MOE_CACHE_*`
 | `MOE_CACHE_POOL_CLAIM` | How many work chunks each plugin worker thread grabs at a time from the shared queue. Clamped to 1..64. A non-number counts as 1. | 1 | internal/testing |
 | `MOE_CACHE_POOL_TINY` | When on, a job of a single chunk runs directly on the calling thread, with no wake-up of the worker threads. Set `0` (or `off`/`false`/`no`) to turn that shortcut off. | On | internal/testing |
 | `MOE_CACHE_PRELOAD` | Set to `1` by the launcher together with `LD_PRELOAD` when the plugin is loaded that way; the plugin reads it to know it was preloaded. The GPU cache option needs it. Do not set it by hand. | Off | set by the launcher |
+| `MOE_CACHE_PROBE_CACHE` | Only when exactly `1`: the launcher saves the Vulkan GPU limits it measures in a file (keyed by device names and the llama-server file size and date), so a restart skips the measurement. | Off | advanced |
 | `MOE_CACHE_PROC_PRIO` | Windows only (does nothing elsewhere). Any value starting with `h` raises the process CPU priority to High; any other non-empty value raises it to Above Normal. Prints whether Windows accepted it. | Off (priority unchanged) | advanced |
 | `MOE_CACHE_PROFILE_DECAY` | A number from 0 to 1: how much of the previously learned expert-usage profile is kept when it is combined with this session's usage when the profile is saved (0 forgets old usage, 1 keeps it fully). Bad values are ignored with a warning. | 0.5 | advanced |
 | `MOE_CACHE_PROMPT_CACHE_MIB` | Sets llama-server's prompt cache size (`--cache-ram`) in MiB, replacing the launcher's rule. Only a plain whole number counts; 0 turns the prompt cache off. | Unset (0 under 16 GB of server RAM, otherwise 2048 MiB) | advanced |
