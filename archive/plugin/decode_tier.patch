+// MOE_CACHE_DECODE_TIER_CHECK=1: the GPU result of nodes first..last is in place; keep a copy, run the CPU executor for the same nodes (the text then comes from the CPU, as
+// without the tier) and compare. A GPU result that is merely rounded differently shows as a relative error near 1e-3; a wrong one (the single-token defect of T25) as 1e-1 or more.
+void tier_check(moe_cache_backend_ctx * c, state_t & s, ggml_cgraph * cg, int first, int last) {
+    ggml_tensor * out = ggml_graph_node(cg, last);
+    const size_t nb = ggml_nbytes(out);
+    const std::vector<char> gpu((const char *) out->data, (const char *) out->data + nb);
+    for (int j = first; j <= last; j++) {
+        ggml_tensor * nd = ggml_graph_node(cg, j);
+        if (nd->op == GGML_OP_MUL_MAT_ID) {
+            exec_wait_loaded(s, nd);
+            exec_one_op(s, nd);
+        } else {
+            exec_run_nodes(c, cg, std::vector<int>{ j });
+        }
+    }
+    const float * g = (const float *) gpu.data(), * h = (const float *) out->data;
+    size_t exact = 0;
+    double mx = 0, ref = 0;
+    for (size_t k = 0; k < nb / sizeof(float); k++) {
+        const double d = std::fabs((double) g[k] - (double) h[k]);
+        exact += d == 0;
+        mx = std::max(mx, d);
+        ref = std::max(ref, std::fabs((double) h[k]));
+    }
+    static uint64_t n = 0, bad = 0;
+    static double worst = 0;
+    const double rel = ref > 0 ? mx / ref : 0;
+    worst = std::max(worst, rel);
+    n++;
+    bad += rel > 0.05;
+    if (n <= 4 || (rel > 0.05 && bad <= 8) || n % 2000 == 0) {
+        fprintf(stderr, "moe-cache: decode tier check #%llu: layer %d, %zu of %zu values equal, largest difference %.3g of %.3g (%.2g relative); worst so far %.2g, %llu groups above 0.05\n",
+                (unsigned long long) n, s.tensors[(size_t) s.by_tensor.at(ggml_graph_node(cg, first)->src[0])]->layer, exact, nb / sizeof(float), mx, ref, rel, worst, (unsigned long long) bad);
+    }
+}
+
 }  // namespace
diff --git a/src/mc_tier.h b/src/mc_tier.h
new file mode 100644
index 0000000..7c7eead
--- /dev/null
+++ b/src/mc_tier.h
@@ -0,0 +1,46 @@
+// moe-cache plugin: which layers the decode tier (MOE_CACHE_DECODE_TIER, experimental, default off) keeps on the GPU, kept free of ggml so
+// tests/tier_test.cpp can check it without a model. docs/DECODE_TIER_DESIGN.md says what the tier is for.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdlib>
+#include <map>
+#include <vector>
+
+// "38,39" -> {38, 39}: layer numbers in the order given; junk, negative numbers and duplicates are dropped; at most 32
+inline std::vector<int> tier_parse(const char * s) {
+    std::vector<int> v;
+    while (s && *s && v.size() < 32) {
+        char * end = nullptr;
+        const long n = strtol(s, &end, 10);
+        if (end == s) {
+            s++;                       // not a number: skip one character
+            continue;
+        }
+        if (n >= 0 && n < 100000 && std::find(v.begin(), v.end(), (int) n) == v.end()) {
+            v.push_back((int) n);
+        }
+        s = end;
+    }
+    return v;
+}
+
+// The wanted layers, in the order given, that fit together in free_bytes - keep_bytes. layer_bytes: bytes of a whole layer's experts (a layer
+// that does not exist in the map is skipped). The first layer that does not fit ends the list, so the order of the wish is the order of value.
+inline std::vector<int> tier_fit(const std::vector<int> & want, const std::map<int, size_t> & layer_bytes, size_t free_bytes, size_t keep_bytes) {
+    std::vector<int> out;
+    const size_t room = free_bytes > keep_bytes ? free_bytes - keep_bytes : 0;
+    size_t used = 0;
+    for (int l : want) {
+        const auto it = layer_bytes.find(l);
+        if (it == layer_bytes.end() || it->second == 0) {
+            continue;
+        }
+        if (used + it->second > room) {
+            break;
+        }
+        used += it->second;
+        out.push_back(l);
+    }
+    return out;
+}
