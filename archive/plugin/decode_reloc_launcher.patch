+"""Give GPU layers back after the prompt (ledger DECODE-630): the launcher side.
+
+Idea: size the card for the big prompt chunk (-ub 2048), then, once the prompt is read and the server only decodes, shrink the chunk to
+-ub 512 and move the experts of a few more layers onto the GPU in the memory the big compute buffer held. The work is done inside llama.cpp
+by patches/llama.cpp/0070-decode-reloc.patch (env LLAMA_DECODE_RELOC, off unless set). This file only decides, in plain numbers, whether to
+switch it on and what to tell it. Switch: MOE_CACHE_DECODE_RELOC=1 (default off). Design: docs/DECODE_RELOC_DESIGN.md.
+
+Pure functions, no GPU and no GGUF needed for `size_extra` and `launcher_env` with `lay` and the buffer sizes passed in (tests/decode_reloc_test.py).
+"""
+import os
+
+SWITCH = "MOE_CACHE_DECODE_RELOC"
+DEFAULT_DECODE_UB = 512
+HARD_MAX_LAYERS = 8
+KEEP_MIB = 768            # VRAM that stays free after the move (the plugin's block buffer is held, other programs, growth)
+_MiB = 1048576
+
+
+def enabled(environ=None):
+    v = (environ if environ is not None else os.environ).get(SWITCH, "")
+    return v.strip().lower() in ("1", "on", "true", "yes")
+
+
+def block_mib(layer_bytes, ub):
+    """The long-prompt block room the planner keeps for a micro-batch (gguf_plan.tune: block_for, table rule)."""
+    return ((1.6 if ub > 1024 else 1.35) * layer_bytes + (160 + 256) * _MiB) / _MiB if layer_bytes else 0.0
+
+
+def size_extra(layer_bytes, cpu_layers, compute_prompt_mib, compute_decode_mib, ub_prompt, ub_decode):
+    """How much room the switch to the small chunk frees and how many whole layers that is.
+    Returns dict(freed_mib, layer_mib, expected_extra, max_layers). expected_extra rounds down and counts no leftover (conservative);
+    max_layers (what the patch may try) is one more, because the patch looks at the real free memory and stops when a layer does not fit."""
+    if not layer_bytes or cpu_layers <= 0:
+        return {"freed_mib": 0.0, "layer_mib": 0.0, "expected_extra": 0, "max_layers": 0}
+    freed = max(0.0, compute_prompt_mib - compute_decode_mib) + max(0.0, block_mib(layer_bytes, ub_prompt) - block_mib(layer_bytes, ub_decode))
+    layer_mib = layer_bytes / _MiB
+    extra = min(cpu_layers, int(freed // layer_mib))
+    return {"freed_mib": freed, "layer_mib": layer_mib, "expected_extra": extra,
+            "max_layers": min(cpu_layers, HARD_MAX_LAYERS, extra + 1) if extra > 0 else 0}
+
+
+_NO_GO = ("--device", "-dev", "--tensor-split", "-ts", "--override-tensor", "-ot", "--spec-type", "--draft-mtp", "--model-draft", "-md")
+
+
+def launcher_env(environ, *, lay, ctx, ub, ncmoe, extra, gcache, compute_mib):
+    """-> (env pairs for llama-server, one line to show or None).
+    `lay` is gguf_plan.model_layout(); `compute_mib(ctx, ub)` gives the planner's GPU compute buffer in MiB.
+    Nothing is added unless MOE_CACHE_DECODE_RELOC is set; a reason is returned when it is set and cannot be used."""
+    if not enabled(environ):
+        return [], None
+    no = lambda why: ([], f"moe-cache: {SWITCH} ignored: {why}")
+    if gcache != "off":
+        return no("a GPU expert cache is in use (static layers only)")
+    if not str(ncmoe).isdigit() or int(ncmoe) <= 0 or int(ncmoe) >= (lay.get("n_layers") or 0):
+        return no("no mix of CPU and GPU expert layers to rebalance (--n-cpu-moe " + str(ncmoe) + ")")
+    bad = [x for x in extra if x in _NO_GO or "mtp" in str(x).lower() or str(x).startswith(("--device=", "--override-tensor=", "--tensor-split="))]
+    if bad:
+        return no(f"not supported with {bad[0]} (one GPU, no MTP / draft model, no -ot)")
+    try:
+        ubd = int(environ.get(SWITCH + "_UB") or DEFAULT_DECODE_UB)
+        ubp = int(ub)
+    except (TypeError, ValueError):
+        return no("the micro-batch is not a number")
+    if ubd >= ubp:
+        return no(f"the prompt chunk {ubp} is not larger than the decode chunk {ubd}")
+    s = size_extra(lay.get("expert_bytes_per_layer") or 0, int(ncmoe), compute_mib(ctx, ubp) or 0, compute_mib(ctx, ubd) or 0, ubp, ubd)
+    if s["max_layers"] <= 0:
+        return no(f"going from -ub {ubp} to {ubd} frees {s['freed_mib']:.0f} MiB, less than one layer ({s['layer_mib']:.0f} MiB)")
+    pairs = [("LLAMA_DECODE_RELOC", "1"), ("LLAMA_DECODE_RELOC_UB", str(ubd)), ("LLAMA_DECODE_RELOC_MAX_LAYERS", str(s["max_layers"])),
+             ("LLAMA_DECODE_RELOC_KEEP_MIB", str(int(environ.get(SWITCH + "_KEEP_MIB") or KEEP_MIB)))]
+    return pairs, (f"moe-cache: {SWITCH}=1: after the prompt -ub {ubp} becomes {ubd} and up to {s['max_layers']} more layers of experts move to the GPU "
+                   f"(planner estimate {s['expected_extra']} from {s['freed_mib']:.0f} MiB freed; needs the patched llama.cpp, patch 0070; PROTOTYPE)")
diff --git b/tests/decode_reloc_live.cpp a/tests/decode_reloc_live.cpp
new file mode 100644
index 0000000..6fe8505
--- /dev/null
+++ a/tests/decode_reloc_live.cpp
@@ -0,0 +1,151 @@
+// Tiny-model check for llama.cpp patch 0070 (LLAMA_DECODE_RELOC, DECODE-630). Not part of tools/run_quick_tests.sh: it needs a patched llama.cpp
+// build (CUDA) and a small MoE GGUF. tests/decode_reloc_live.sh builds and runs it.
+//   decode_reloc_live MODEL.gguf [twoctx|late2|long]
+// Prints token ids only (greedy), so two runs (LLAMA_DECODE_RELOC unset / =1) can be compared with diff:
+//   phase 1: prompt of 300 tokens in chunks of 256, then 30 single-token steps (the decode phase starts after LLAMA_DECODE_RELOC_AFTER of them)
+//   phase 2: save the sequence state (warm-session slot save), 20 more tokens (G2), clear, restore, 20 tokens again (G3); G3 must equal G2
+//   phase 3: a 100-token batch (more than the decode chunk: the layers move back), then 10 tokens
+// "twoctx": a second context on the same model is created first (MTP / draft stand-in); the patch must refuse, the tokens must not change.
+// "late2":  the second context is created AFTER the first one moved the layers (prompt, 30 steps), runs its own prompt and 30 steps, then the first
+//           context goes on for 20 steps: its reloc_step sees two live contexts and moves back; no crash, tokens equal to the run with the switch off.
+// "long":   greedy identity, 4 prompts (50 / 700 / 300 / 1500 tokens, one batch each) x 600 generated tokens = 2400 tokens, memory cleared between
+//           prompts, default LLAMA_DECODE_RELOC_UB (512) and AFTER (64): the 700 and 1500 token batches arrive in the decode phase (more than 512:
+//           the layers move back). Prints the token ids and the text (non-printable bytes escaped) per prompt.
+// LLAMA_DECODE_RELOC_FAIL=1|2 (test only, in the patch) makes the first / second reserve of the move throw: default mode, tokens must equal the off run.
+#include "llama.h"
+#include "ggml-backend.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <string>
+
+static int argmax(const float * l, int n) { int b = 0; for (int i = 1; i < n; i++) if (l[i] > l[b]) b = i; return b; }
+
+static int step(llama_context * ctx, std::vector<llama_token> & t, int n_vocab, std::vector<int> & out) {
+    llama_batch b = llama_batch_get_one(t.data(), (int32_t) t.size());
+    if (llama_decode(ctx, b) != 0) { fprintf(stderr, "decode failed\n"); return -1; }
+    int id = argmax(llama_get_logits_ith(ctx, -1), n_vocab);
+    out.push_back(id);
+    return id;
+}
+
+static void dump(const char * n, const std::vector<int> & v) { printf("%s:", n); for (int x : v) printf(" %d", x); printf("\n"); }
+
+int main(int argc, char ** argv) {
+    if (argc < 2) { fprintf(stderr, "usage: %s MODEL [twoctx|late2|long]\n", argv[0]); return 2; }
+    const bool twoctx = argc > 2 && !strcmp(argv[2], "twoctx");
+    const bool late2  = argc > 2 && !strcmp(argv[2], "late2");
+    const bool lng    = argc > 2 && !strcmp(argv[2], "long");
+    ggml_backend_load_all();
+    llama_backend_init();
+    llama_model_params mp = llama_model_default_params();
+    mp.n_gpu_layers = getenv("LIVE_NGL") ? atoi(getenv("LIVE_NGL")) : 99;     // LIVE_NGL=0: CPU only (CI without a GPU: the patch must stay inert)
+    // the experts of layers 0..2 stay in host memory (plain CPU buffer, as --n-cpu-moe 3 does)
+    llama_model_tensor_buft_override ov[2] = { { "blk\\.[0-2]\\.ffn_.*_exps", ggml_backend_cpu_buffer_type() }, { nullptr, nullptr } };
+    mp.tensor_buft_overrides = ov;
+    llama_model * model = llama_model_load_from_file(argv[1], mp);
+    if (!model) { fprintf(stderr, "load failed\n"); return 1; }
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx = 2048; cp.n_batch = 256; cp.n_ubatch = 256; cp.n_seq_max = 1;
+    if (lng) { cp.n_ctx = 4096; cp.n_batch = 2048; cp.n_ubatch = 2048; }
+    llama_context * ctx2 = twoctx ? llama_init_from_model(model, cp) : nullptr;
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { fprintf(stderr, "context failed\n"); return 1; }
+
+    auto tok = [&](int i) { return (llama_token) (5 + (i * 7) % 50 % n_vocab); };
+    if (lng) {
+        const llama_vocab * vocab = llama_model_get_vocab(model);
+        const int lens[4] = { 50, 700, 300, 1500 };
+        const int n_gen = 600;
+        for (int k = 0; k < 4; k++) {
+            llama_memory_clear(llama_get_memory(ctx), true);
+            const int seed = 3 + 4 * k;
+            std::vector<llama_token> t(lens[k]);
+            for (int i = 0; i < lens[k]; i++) t[i] = (llama_token) ((5 + (i * seed + (i * i) % 97) % 400) % n_vocab);
+            std::vector<int> g, sink;
+            int last = step(ctx, t, n_vocab, sink);
+            if (last < 0) return 1;
+            g.push_back(last);
+            for (int i = 1; i < n_gen; i++) { std::vector<llama_token> u = { (llama_token) last }; last = step(ctx, u, n_vocab, g); if (last < 0) return 1; }
+            char name[16]; snprintf(name, sizeof name, "P%d", k);
+            dump(name, g);
+            printf("T%d: ", k);
+            for (int id : g) {
+                char buf[256]; int n = llama_token_to_piece(vocab, id, buf, sizeof buf, 0, true);
+                for (int j = 0; j < n; j++) { unsigned char c = buf[j]; if (c >= 32 && c < 127 && c != 92) putchar(c); else printf("\\x%02x", c); }
+            }
+            printf("\n");
+        }
+        llama_free(ctx);
+        llama_model_free(model);
+        return 0;
+    }
+    if (late2) {
+        std::vector<int> a1, a2, a3, a4, sk;
+        int p = 0, l = -1;
+        while (p < 300) {
+            int n = std::min(256, 300 - p);
+            std::vector<llama_token> t(n);
+            for (int i = 0; i < n; i++) t[i] = tok(p + i);
+            l = step(ctx, t, n_vocab, sk);
+            if (l < 0) return 1;
+            p += n;
+        }
+        for (int i = 0; i < 30; i++) { std::vector<llama_token> t = { (llama_token) l }; l = step(ctx, t, n_vocab, a1); if (l < 0) return 1; }
+        llama_context * c2 = llama_init_from_model(model, cp);   // the layers of ctx are moved now
+        if (!c2) { fprintf(stderr, "second context failed\n"); return 1; }
+        int l2 = -1; p = 0;
+        while (p < 300) {
+            int n = std::min(256, 300 - p);
+            std::vector<llama_token> t(n);
+            for (int i = 0; i < n; i++) t[i] = tok(p + i);
+            l2 = step(c2, t, n_vocab, sk);
+            if (l2 < 0) return 1;
+            p += n;
+        }
+        for (int i = 0; i < 30; i++) { std::vector<llama_token> t = { (llama_token) l2 }; l2 = step(c2, t, n_vocab, a2); if (l2 < 0) return 1; }
+        for (int i = 0; i < 20; i++) { std::vector<llama_token> t = { (llama_token) l }; l = step(ctx, t, n_vocab, a3); if (l < 0) return 1; }
+        for (int i = 0; i < 10; i++) { std::vector<llama_token> t = { (llama_token) l2 }; l2 = step(c2, t, n_vocab, a4); if (l2 < 0) return 1; }
+        dump("A1", a1); dump("A2", a2); dump("A3", a3); dump("A4", a4);
+        printf("ctx2_matches_ctx1: %s\n", a1 == a2 ? "yes" : "NO");
+        llama_free(c2);
+        llama_free(ctx);
+        llama_model_free(model);
+        return 0;
+    }
+    std::vector<int> g1, g2, g3, g4, sink;
+    int pos = 0, last = -1;
+    while (pos < 300) {                                       // phase 1: prompt chunks
+        int n = std::min(256, 300 - pos);
+        std::vector<llama_token> t(n);
+        for (int i = 0; i < n; i++) t[i] = tok(pos + i);
+        last = step(ctx, t, n_vocab, sink);
+        pos += n;
+    }
+    for (int i = 0; i < 30; i++) { std::vector<llama_token> t = { (llama_token) last }; last = step(ctx, t, n_vocab, g1); }
+    // phase 2: slot save / restore in the decode phase
+    std::vector<uint8_t> state(llama_state_seq_get_size(ctx, 0));
+    llama_state_seq_get_data(ctx, state.data(), state.size(), 0);
+    const int last_saved = last;
+    for (int i = 0; i < 20; i++) { std::vector<llama_token> t = { (llama_token) last }; last = step(ctx, t, n_vocab, g2); }
+    llama_memory_clear(llama_get_memory(ctx), true);
+    llama_state_seq_set_data(ctx, state.data(), state.size(), 0);
+    last = last_saved;
+    for (int i = 0; i < 20; i++) { std::vector<llama_token> t = { (llama_token) last }; last = step(ctx, t, n_vocab, g3); }
+    // phase 3: a new prompt chunk bigger than the decode chunk, then decode again
+    {
+        std::vector<llama_token> t(100);
+        for (int i = 0; i < 100; i++) t[i] = tok(1000 + i);
+        last = step(ctx, t, n_vocab, sink);
+    }
+    for (int i = 0; i < 10; i++) { std::vector<llama_token> t = { (llama_token) last }; last = step(ctx, t, n_vocab, g4); }
+
+    dump("G1", g1); dump("G2", g2); dump("G3", g3); dump("G4", g4);
+    printf("restore_matches: %s\n", g2 == g3 ? "yes" : "NO");
+    llama_free(ctx);
+    if (ctx2) llama_free(ctx2);
+    llama_model_free(model);
+    return g2 == g3 ? 0 : 3;
+}
diff --git b/tests/decode_reloc_live.sh a/tests/decode_reloc_live.sh
new file mode 100755
index 0000000..1c18eac
--- /dev/null
+++ a/tests/decode_reloc_live.sh
@@ -0,0 +1,115 @@
+#!/bin/bash
+# Tiny-model check of llama.cpp patch 0070 (DECODE-630); needs a CUDA build of the patched llama.cpp and a small MoE GGUF. Not in the quick set.
+#   tests/decode_reloc_live.sh LLAMA_CPP_DIR BUILD_DIR MODEL.gguf
+# Env: DECODE_RELOC_EXPECT=moved (default) the switch-on run must really move layers (a machine with a GPU, e.g. the laptop);
+#      DECODE_RELOC_EXPECT=any   CI without a real GPU (llama_patched.yml): checks that need a move are skipped, with a line saying so, when none happened;
+#      DECODE_RELOC_SKIP_LONG=1  leave out the 2400-token run (a software GPU such as lavapipe is too slow for it);
+#      DECODE_RELOC_PLUGIN=LIB   also run with the moe-cache plugin loaded (GGML_BACKEND_PATH) and a 2 MB cache so experts are evicted: the experts of the host layers
+#                                (DECODE_RELOC_PLUGIN_CACHE_GIB, default 0.002) are then in the plugin's MOE_CACHE buffer (not "host" memory) and must still move, through get_tensor, with the same tokens;
+#      DECODE_RELOC_EXE_DIR=DIR  where the test program is put (default: a temporary folder); a build with dynamic backends (GGML_BACKEND_DL) finds them next to the program.
+# Runs tests/decode_reloc_live.cpp with the switch unset and set (and with a second context) and compares the token ids. Also:
+#   reserve failure: LLAMA_DECODE_RELOC_FAIL=1 (first reserve throws) and =2 (reserve after the move throws): the run goes on, the layers are back, tokens equal
+#   late second context: created after the move; the first context moves back at its next batch; no crash, tokens equal
+#   long greedy identity: 2400 tokens, 4 prompts (700 and 1500 tokens arrive in the decode phase), off vs on; identical yes/no and the first differing token are reported (a difference is not a failure)
+set -e
+export LC_ALL=C
+SRC="${1:?llama.cpp dir}"; BLD="${2:?build dir}"; MODEL="${3:?model}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OUT="$(mktemp -d)"; EXE="${DECODE_RELOC_EXE_DIR:-$OUT}"; EXPECT="${DECODE_RELOC_EXPECT:-moved}"
+g++ -std=c++17 -O1 -Wall -I"$SRC/include" -I"$SRC/ggml/include" "$HERE/decode_reloc_live.cpp" -L"$BLD/bin" -lllama -lggml -lggml-base -Wl,-rpath,"$BLD/bin" -o "$EXE/live"
+export LLAMA_DECODE_RELOC_UB=32 LLAMA_DECODE_RELOC_AFTER=8 LLAMA_DECODE_RELOC_KEEP_MIB=200
+env -u LLAMA_DECODE_RELOC "$EXE/live" "$MODEL" > "$OUT/off.txt" 2> "$OUT/off.err"
+LLAMA_DECODE_RELOC=1 "$EXE/live" "$MODEL" > "$OUT/on.txt" 2> "$OUT/on.err"
+LLAMA_DECODE_RELOC=1 "$EXE/live" "$MODEL" twoctx > "$OUT/two.txt" 2> "$OUT/two.err"
+# a run that may fail: keep its exit code in $OUT/NAME.rc, do not stop the script
+run() { local n="$1"; shift; set +e; "$@" > "$OUT/$n.txt" 2> "$OUT/$n.err"; echo $? > "$OUT/$n.rc"; set -e; }
+run f1 env LLAMA_DECODE_RELOC=1 LLAMA_DECODE_RELOC_FAIL=1 "$EXE/live" "$MODEL"
+run f2 env LLAMA_DECODE_RELOC=1 LLAMA_DECODE_RELOC_FAIL=2 "$EXE/live" "$MODEL"
+run l_off env -u LLAMA_DECODE_RELOC "$EXE/live" "$MODEL" late2
+run l_on env LLAMA_DECODE_RELOC=1 "$EXE/live" "$MODEL" late2
+[ -n "${DECODE_RELOC_SKIP_LONG:-}" ] || run g_off env -u LLAMA_DECODE_RELOC -u LLAMA_DECODE_RELOC_UB -u LLAMA_DECODE_RELOC_AFTER -u LLAMA_DECODE_RELOC_KEEP_MIB "$EXE/live" "$MODEL" long
+[ -n "${DECODE_RELOC_SKIP_LONG:-}" ] || run g_on env -u LLAMA_DECODE_RELOC_UB -u LLAMA_DECODE_RELOC_AFTER -u LLAMA_DECODE_RELOC_KEEP_MIB LLAMA_DECODE_RELOC=1 "$EXE/live" "$MODEL" long
+# diagnostics: the memory figure is the real one (or says it was not queried); LLAMA_DECODE_RELOC_FAKE_FREE_MIB (test only) pretends the device has little free memory
+run f3 env LLAMA_DECODE_RELOC=1 LLAMA_DECODE_RELOC_FAKE_FREE_MIB=50 "$EXE/live" "$MODEL"
+if [ -n "${DECODE_RELOC_PLUGIN:-}" ]; then
+  PENV=(GGML_BACKEND_PATH="$DECODE_RELOC_PLUGIN" MOE_CACHE_GGUF="$MODEL" MOE_CACHE_SIZE_GIB="${DECODE_RELOC_PLUGIN_CACHE_GIB:-0.002}" MOE_CACHE_STATS=1)
+  run p_off env -u LLAMA_DECODE_RELOC "${PENV[@]}" "$EXE/live" "$MODEL"
+  run p_on env LLAMA_DECODE_RELOC=1 "${PENV[@]}" "$EXE/live" "$MODEL"
+  run pl_off env -u LLAMA_DECODE_RELOC "${PENV[@]}" "$EXE/live" "$MODEL" late2
+  run pl_on env LLAMA_DECODE_RELOC=1 "${PENV[@]}" "$EXE/live" "$MODEL" late2
+fi
+# shrink only (LLAMA_DECODE_RELOC_MAX_LAYERS=0): the small micro-batch during decode, nothing moves, the big one comes back for a big chunk
+run sh_on env LLAMA_DECODE_RELOC=1 LLAMA_DECODE_RELOC_MAX_LAYERS=0 "$EXE/live" "$MODEL"
+[ -z "${DECODE_RELOC_PLUGIN:-}" ] || run shp_on env LLAMA_DECODE_RELOC=1 LLAMA_DECODE_RELOC_MAX_LAYERS=0 "${PENV[@]}" "$EXE/live" "$MODEL"
+fail=0
+MOVED=0; grep -q 'layers of experts moved to the GPU' "$OUT/on.err" && MOVED=1
+chkm() { if [ "$MOVED" = 1 ]; then chk "$@"; else echo "skip $1 (no layer could move on this machine: $(grep -h 'no layer fits\|not on a GPU' "$OUT/on.err" | head -1 | cut -c1-120))"; fi; }
+chk() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
+chk "switch unset: no patch log line" "! grep -q reloc_ '$OUT/off.err'"
+[ "$EXPECT" != moved ] || chk "EXPECT=moved: the switch-on run moved layers" "[ $MOVED = 1 ]"
+chkm "switch on: layers moved" "grep -q 'layers of experts moved to the GPU' '$OUT/on.err'"
+chkm "switch on: moved back for the big chunk" "grep -q 'back to the prompt layout' '$OUT/on.err'"
+chk "tokens equal with the switch on and off (prompt, decode, restore, move back, decode)" "cmp -s '$OUT/off.txt' '$OUT/on.txt'"
+chk "slot save/restore in the decode phase reproduces the tokens (on)" "grep -q 'restore_matches: yes' '$OUT/on.txt'"
+chk "second context: move refused" "grep -q 'another context' '$OUT/two.err' && ! grep -q 'layers of experts moved' '$OUT/two.err'"
+chk "second context: tokens unchanged" "cmp -s '$OUT/off.txt' '$OUT/two.txt'"
+# shrink only: works on any machine (no move needed)
+shrink_ok() { awk '/shrink only/ { for (i = 1; i <= NF; i++) if ($i == "buffers") { a = $(i+1); b = $(i+4) } } END { exit !(a > 0 && b + 0 < a + 0) }' "$1"; }
+chk "shrink only (MAX_LAYERS=0): the small micro-batch is reserved and the compute buffers get smaller, nothing moves, moved back for the big chunk" "[ \"\$(cat $OUT/sh_on.rc)\" = 0 ] && grep -q 'shrink only (no layer moves)' '$OUT/sh_on.err' && ! grep -q 'layers of experts moved' '$OUT/sh_on.err' && grep -q 'back to the prompt layout' '$OUT/sh_on.err' && cmp -s '$OUT/off.txt' '$OUT/sh_on.txt'"
+chk "shrink only: the logged compute buffers shrank (INFO line: A MiB -> B MiB with B < A)" "$(declare -f shrink_ok); shrink_ok '$OUT/sh_on.err'"
+if [ -n "${DECODE_RELOC_PLUGIN:-}" ]; then
+  chk "shrink only with the plugin loaded (experts evicted): exit 0, tokens equal to the switch off" "[ \"\$(cat $OUT/shp_on.rc)\" = 0 ] && grep -q 'shrink only (no layer moves)' '$OUT/shp_on.err' && cmp -s '$OUT/p_off.txt' '$OUT/shp_on.txt'"
+fi
+# diagnostics
+if [ "$MOVED" = 1 ]; then
+  chk "no layer fits: the log names the memory figure and the reasons (fake free memory 50 MiB)" "[ \"\$(cat $OUT/f3.rc)\" = 0 ] && grep -q 'no layer fits (50 MiB free of 50 MiB' '$OUT/f3.err' && grep -q 'too big for the free memory' '$OUT/f3.err' && cmp -s '$OUT/off.txt' '$OUT/f3.txt'"
+else
+  chk "no layer fits (no GPU here): the log says the memory was not queried and counts the layers not on a GPU" "[ \"\$(cat $OUT/f3.rc)\" = 0 ] && grep -q 'device memory not queried' '$OUT/f3.err' && grep -Eq '[1-9][0-9]* not on a GPU' '$OUT/f3.err' && cmp -s '$OUT/off.txt' '$OUT/f3.txt'"
+fi
+if [ -n "${DECODE_RELOC_PLUGIN:-}" ]; then
+  chk "plugin: the experts are in the MOE_CACHE buffer and the cache evicted (2 MB cache)" "grep -q 'buffer type overridden to MOE_CACHE' '$OUT/p_on.err' && grep -Eq 'evictions=[1-9]' '$OUT/p_on.err'"
+  chk "plugin: exit 0, tokens equal with the switch on and off (experts evicted while the layers move)" "[ \"\$(cat $OUT/p_on.rc)\" = 0 ] && [ \"\$(cat $OUT/p_off.rc)\" = 0 ] && cmp -s '$OUT/p_off.txt' '$OUT/p_on.txt'"
+  chkm "plugin: layers moved, read through the moe-cache buffer" "grep -q 'of them read through the moe-cache buffer' '$OUT/p_on.err' && ! grep -q 'of them read through the moe-cache buffer' '$OUT/p_off.err'"
+  chk "plugin, second context after the move: no crash, tokens equal to the switch off" "[ \"\$(cat $OUT/pl_on.rc)\" = 0 ] && cmp -s '$OUT/pl_off.txt' '$OUT/pl_on.txt'"
+fi
+# test 1: reserve failure
+chk "fail=1: first reserve throws, the log says why" "grep -q 'reserve with ubatch 32 failed (LLAMA_DECODE_RELOC_FAIL=1' '$OUT/f1.err' && ! grep -q 'layers of experts moved' '$OUT/f1.err'"
+chk "fail=1: process finished (exit 0), tokens equal to the switch off" "[ \"\$(cat $OUT/f1.rc)\" = 0 ] && cmp -s '$OUT/off.txt' '$OUT/f1.txt'"
+chkm "fail=2: reserve after the move throws, moved back, the log says why" "! grep -q 'layers of experts moved' '$OUT/f2.err' && grep -q 'reserve after the move failed (LLAMA_DECODE_RELOC_FAIL=2' '$OUT/f2.err' && grep -q 'expert tensors back in their original' '$OUT/f2.err'"
+chk "fail=2: process finished (exit 0), tokens equal to the switch off" "[ \"\$(cat $OUT/f2.rc)\" = 0 ] && cmp -s '$OUT/off.txt' '$OUT/f2.txt'"
+chk "fail=1: no second try (one failure line)" "[ \"\$(grep -c 'failed (LLAMA_DECODE_RELOC_FAIL' '$OUT/f1.err')\" = 1 ]"
+chkm "fail=2: no second try (one failure line)" "[ \"\$(grep -c 'failed (LLAMA_DECODE_RELOC_FAIL' '$OUT/f2.err')\" = 1 ]"
+# test 2: second context created after the move
+chkm "late 2nd context: layers were moved first, then the first context moved back (log)" "grep -q 'layers of experts moved' '$OUT/l_on.err' && grep -q 'another context was created, moving back' '$OUT/l_on.err'"
+chk "late 2nd context: no crash (exit 0) with the switch on and off" "[ \"\$(cat $OUT/l_on.rc)\" = 0 ] && [ \"\$(cat $OUT/l_off.rc)\" = 0 ]"
+chk "late 2nd context: tokens of both contexts equal to the switch off" "cmp -s '$OUT/l_off.txt' '$OUT/l_on.txt'"
+# test 3: long greedy identity
+if [ -n "${DECODE_RELOC_SKIP_LONG:-}" ]; then echo "skip long greedy identity (DECODE_RELOC_SKIP_LONG)"; else
+ntok=$(grep -E '^P[0-9]:' "$OUT/g_on.txt" | wc -w); ntok=$((ntok - 4))
+chk "long: at least 2000 tokens generated ($ntok), exit 0" "[ $ntok -ge 2000 ] && [ \"\$(cat $OUT/g_on.rc)\" = 0 ] && [ \"\$(cat $OUT/g_off.rc)\" = 0 ]"
+chkm "long: layers moved at least twice and moved back at least twice (700 and 1500 token batches in the decode phase)" "[ \$(grep -c 'layers of experts moved' '$OUT/g_on.err') -ge 2 ] && [ \$(grep -c 'back to the prompt layout' '$OUT/g_on.err') -ge 2 ]"
+if cmp -s "$OUT/g_off.txt" "$OUT/g_on.txt"; then echo "ok   long: text and token ids byte-identical, switch off vs on"
+else
+  # owner's rule: semantic similarity, not byte identity (CPU -> GPU expert matmuls may change floats). A difference is reported, not a failure; a crash,
+  # garbage or a wrong restore is (the checks above and the fail=1/2, late2 checks).
+  echo "DIFF long: not byte-identical, switch off vs on (reported, not a failure; compare the text below by eye)"
+  python3 -I - "$OUT/g_off.txt" "$OUT/g_on.txt" <<'PY'
+import sys
+a = open(sys.argv[1]).read().splitlines(); b = open(sys.argv[2]).read().splitlines()
+for la, lb in zip(a, b):
+    if la != lb:
+        name = la.split(":")[0]
+        if name.startswith("T"):
+            print("  first differing text char in", name, "at index", next((i for i, (x, y) in enumerate(zip(la, lb)) if x != y), min(len(la), len(lb))))
+        else:
+            ta, tb = la.split()[1:], lb.split()[1:]
+            i = next((i for i, (x, y) in enumerate(zip(ta, tb)) if x != y), min(len(ta), len(tb)))
+            print("  first differing token in", name, "at generated index", i, ": off", ta[i:i+1], "on", tb[i:i+1], "; tokens differing in this prompt:", sum(x != y for x, y in zip(ta, tb)), "of", len(ta))
+        break
+else:
+    print("  line counts differ:", len(a), len(b))
+PY
+fi
+fi
+echo "logs in $OUT"
+exit $fail
