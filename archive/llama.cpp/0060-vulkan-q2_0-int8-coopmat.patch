+#elif defined(DATA_A_Q2_0)
+
+// Q2_0: 64 values per block, one scale, w = (q - 1) * d with q in 0..3. A cm1 k step is 32 values,
+// so a block is two steps (ib / 2 is the block, ib & 1 the half) and both halves use the same scale.
+struct block_a_prefetch {
+    uint32_t qs;   // two bytes of qs = eight 2-bit values
+    float16_t d;
+};
+
+block_a_prefetch block_a_load(uint ib, uint loadr) {
+    block_a_prefetch blk;
+    const uint ib_k = ib / 2;
+    const uint half_idx = ib & 1u;
+    blk.qs = uint32_t(data_a_packed16[ib_k].qs[half_idx * 4u + loadr]);
+    blk.d = data_a_packed16[ib_k].d;
+    return blk;
+}
+
+// Spread the four 2-bit values of a byte into the four byte lanes of a word and subtract 1 in every lane.
+uint32_t q2_0_byte_to_i8x4(uint32_t b) {
+    const uint32_t w = (b & 0x03u) | ((b & 0x0Cu) << 6) | ((b & 0x30u) << 12) | ((b & 0xC0u) << 18);
+    return ((w | 0x80808080) - 0x01010101) ^ 0x80808080;
+}
+
+void block_a_to_shmem(block_a_prefetch blk, uint buf_ib, uint ks, uint loadr, bool in_bounds) {
+    buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + loadr * 2    ] = q2_0_byte_to_i8x4(blk.qs & 0xFFu);
+    buf_a_qs[buf_ib * QPITCH + ks * (BK / 4) + loadr * 2 + 1] = q2_0_byte_to_i8x4(blk.qs >> 8);
+
+    if (loadr == 0) {
+        buf_a_d[ks * BM + buf_ib] = in_bounds ? float(blk.d) : 0.0f;
+    }
+}
+
