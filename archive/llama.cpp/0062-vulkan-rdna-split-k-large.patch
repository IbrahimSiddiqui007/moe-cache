+// GGML_VK_RDNA_SPLIT_K_LARGE=1 (default off): RDNA3/RDNA4 also split K in 3 when the tile grid fills at most
+// 2/3 of the last wave of compute units (llama.cpp #30280, measured there on an RX 9070 XT). 2 = the same rule
+// on any device (a test mode, so the split-K path can be checked on a card that is not AMD).
+static int ggml_vk_rdna_split_k_large() {
+    static const int mode = getenv("GGML_VK_RDNA_SPLIT_K_LARGE") ? atoi(getenv("GGML_VK_RDNA_SPLIT_K_LARGE")) : 0;
+    return mode;
+}
