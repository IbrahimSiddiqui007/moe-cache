diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index f4e9257c3..5029c9862 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -346,6 +346,19 @@ llama_context::llama_context(
     cparams.n_ubatch = std::min(cparams.n_batch, params.n_ubatch == 0 ? params.n_batch : params.n_ubatch);
 
     cparams.n_outputs_max = params.n_outputs_max == 0 || llama_model_has_encoder(&model) ? cparams.n_batch : params.n_outputs_max;
+    // LLAMA_N_OUTPUTS_MAX=N: reserve (and accept) at most N output rows per ubatch instead of n_batch. The reserved graph
+    // holds n_vocab x n_outputs x 4 bytes of logits, often the largest tensor of the compute buffer (see LLAMA_RESERVE_TOP).
+    // A batch with more outputs than N still decodes (output_reserve sizes the host buffers from the batch), but its graph is
+    // larger than the reserved one, so the compute buffer grows at that moment and can fail if the GPU is full by then;
+    // backend samplers are limited to N outputs per sequence. Not used when the caller set n_outputs_max itself.
+    if (params.n_outputs_max == 0 && !llama_model_has_encoder(&model)) {
+        if (const char * e = getenv("LLAMA_N_OUTPUTS_MAX")) {
+            const long n = atol(e);
+            if (n > 0) {
+                cparams.n_outputs_max = std::max<uint32_t>(std::min<uint32_t>((uint32_t) n, cparams.n_batch), cparams.n_seq_max);
+            }
+        }
+    }
     cparams.n_outputs_max_per_seq = params.n_outputs_max_per_seq == 0 ?
             cparams.n_outputs_max : std::min(params.n_outputs_max_per_seq, cparams.n_outputs_max);
 
