--- a/common/common.cpp
+++ b/common/common.cpp
@@ -21,6 +21,8 @@
 #include <chrono>
 #include <cstdarg>
 #include <cstring>
+#include <deque>
+#include <mutex>
 #include <ctime>
 #include <filesystem>
 #include <fstream>
@@ -1868,6 +1870,39 @@ std::vector<llama_token> common_tokenize(
            const std::string & text,
                         bool   add_special,
                         bool   parse_special) {
+    // moe-cache patch 0005 (S08): LLAMA_TOKENIZE_CACHE=1 remembers the result for the last few long texts, so
+    // an identical text (retry, regenerate, same prompt sent again) is not tokenized twice. The key is the whole
+    // text plus the flags plus the vocab; no part of a text is reused, so the tokens are exactly those of a new call.
+    struct tok_cache_entry {
+        const llama_vocab *      vocab = nullptr;
+        uint64_t                 vocab_sig = 0;
+        bool                     add_special = false;
+        bool                     parse_special = false;
+        std::string              text;
+        std::vector<llama_token> tokens;
+    };
+    static const size_t tok_cache_min_bytes = []() {
+        const char * e = getenv("LLAMA_TOKENIZE_CACHE");
+        return e != nullptr && atoi(e) != 0 ? (size_t) 4096 : (size_t) 0; // 0 = off
+    }();
+    static std::mutex                 tok_cache_mutex;
+    static std::deque<tok_cache_entry> tok_cache;
+    uint64_t vocab_sig = 0;
+    if (tok_cache_min_bytes != 0 && text.size() >= tok_cache_min_bytes) {
+        // cheap identity of the vocab (a reloaded model can reuse the address): size, type and the text of 16 spread-out tokens
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        vocab_sig = (uint64_t) n_vocab * 1000003u + (uint64_t) llama_vocab_type(vocab);
+        for (int32_t i = 0; i < 16 && n_vocab > 0; ++i) {
+            vocab_sig = vocab_sig * 1099511628211ull ^ std::hash<std::string>()(llama_vocab_get_text(vocab, (llama_token) ((int64_t) i * (n_vocab - 1) / 15)));
+        }
+        std::lock_guard<std::mutex> lock(tok_cache_mutex);
+        for (const auto & e : tok_cache) {
+            if (e.vocab == vocab && e.vocab_sig == vocab_sig && e.add_special == add_special && e.parse_special == parse_special && e.text == text) {
+                return e.tokens;
+            }
+        }
+    }
+
     // upper limit for the number of tokens
     int n_tokens = text.length() + 2 * add_special;
     std::vector<llama_token> result(n_tokens);
@@ -1882,6 +1917,13 @@ std::vector<llama_token> common_tokenize(
     } else {
         result.resize(n_tokens);
     }
+    if (tok_cache_min_bytes != 0 && text.size() >= tok_cache_min_bytes) {
+        std::lock_guard<std::mutex> lock(tok_cache_mutex);
+        tok_cache.push_back({ vocab, vocab_sig, add_special, parse_special, text, result });
+        while (tok_cache.size() > 4) {
+            tok_cache.pop_front();
+        }
+    }
     return result;
 }
 
