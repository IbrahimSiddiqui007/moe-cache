+// GGML_VK_PREALLOC_ALIAS=1: the split-k scratch lives inside prealloc_x, after the x bytes the same op uses, so the two
+// need the largest sum of one op instead of the sum of two separate maxima. prealloc_y stays its own buffer: it is a
+// cache (prealloc_y_last_tensor_used) and keeping it out of the shared region leaves that logic untouched.
+// Every use of x or split-k is then ordered against the other (the two need_sync flags are always set together).
+// GGML_VK_PREALLOC_LOG=1 prints the sizes and the saving at exit (works with the switch off).
+static bool ggml_vk_prealloc_alias() {
+    static const bool v = getenv("GGML_VK_PREALLOC_ALIAS") && atoi(getenv("GGML_VK_PREALLOC_ALIAS")) > 0;
+    return v;
+}
+static bool ggml_vk_prealloc_log() {
+    static const bool v = getenv("GGML_VK_PREALLOC_LOG") && atoi(getenv("GGML_VK_PREALLOC_LOG")) > 0;
+    return v;
+}
+static uint64_t ggml_vk_prealloc_align(const ggml_backend_vk_context * ctx) {
+    return std::max<uint64_t>(256, ctx->device->properties.limits.minStorageBufferOffsetAlignment);
+}
+// offset of the split-k region in prealloc_x for an op that uses x_used bytes of x
+static uint64_t ggml_vk_sk_offset(const ggml_backend_vk_context * ctx, uint64_t x_used) {
+    const uint64_t a = ggml_vk_prealloc_align(ctx);
+    return (x_used + a - 1) / a * a;
+}
+static vk_subbuffer ggml_vk_sk_subbuffer(ggml_backend_vk_context * ctx, uint64_t x_used, uint64_t size) {
+    if (!ggml_vk_prealloc_alias()) {
+        return { ctx->prealloc_split_k, 0, size };
+    }
+    const uint64_t off = ggml_vk_sk_offset(ctx, x_used);
+    GGML_ASSERT(ctx->prealloc_x != nullptr);
+    return { ctx->prealloc_x, off, std::min<uint64_t>(size, ctx->prealloc_x->size > off ? ctx->prealloc_x->size - off : 0) };
+}
+// the whole-buffer range some kernels are bound with; never above the device limit
+static vk_subbuffer ggml_vk_x_whole(ggml_backend_vk_context * ctx) {
+    return { ctx->prealloc_x, 0, std::min<uint64_t>(ctx->prealloc_x->size, ctx->device->properties.limits.maxStorageBufferRange) };
+}
+static void ggml_vk_prealloc_x_used(ggml_backend_vk_context * ctx) {
+    ctx->prealloc_x_need_sync = true;
+    if (ggml_vk_prealloc_alias()) {
+        ctx->prealloc_split_k_need_sync = true;
+    }
+}
+static void ggml_vk_prealloc_sk_used(ggml_backend_vk_context * ctx) {
+    ctx->prealloc_split_k_need_sync = true;
+    if (ggml_vk_prealloc_alias()) {
+        ctx->prealloc_x_need_sync = true;
+    }
+}
+// Called by every op before it uses scratch: x_used / y_used / sk_used are the bytes this one op needs (0 = unused).
+// Grows the buffers like the per-site code did; with the switch on, x and split-k share one buffer.
+static void ggml_vk_prealloc_need(ggml_backend_vk_context * ctx, vk_context& subctx, const char * label, uint64_t x_used, uint64_t y_used, uint64_t sk_used) {
+    if (ggml_vk_prealloc_log()) {
+        vk_prealloc_stats & st = ctx->prealloc_stats;
+        const uint64_t xs = x_used + sk_used ? ggml_vk_sk_offset(ctx, x_used) + sk_used : 0;
+        const auto upd = [&](uint64_t v, uint64_t & mx, std::string & who) { if (v > mx) { mx = v; who = label; } };
+        upd(x_used, st.max_x, st.who_x);
+        upd(y_used, st.max_y, st.who_y);
+        upd(sk_used, st.max_sk, st.who_sk);
+        upd(xs, st.max_xsk, st.who_xsk);
+    }
+    if (ggml_vk_prealloc_alias()) {
+        const uint64_t need = x_used + sk_used ? ggml_vk_sk_offset(ctx, x_used) + sk_used : 0;
+        if (need > 0 && ctx->prealloc_size_x < need) {
+            ctx->prealloc_size_x = need;
+            ggml_vk_preallocate_buffers(ctx, subctx);
+        }
+    } else {
+        if (x_used > 0 && ctx->prealloc_size_x < x_used) {
+            ctx->prealloc_size_x = x_used;
+            ggml_vk_preallocate_buffers(ctx, subctx);
+        }
+    }
+    if (y_used > 0 && ctx->prealloc_size_y < y_used) {
+        ctx->prealloc_size_y = y_used;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    if (!ggml_vk_prealloc_alias() && sk_used > 0 && ctx->prealloc_size_split_k < sk_used) {
+        ctx->prealloc_size_split_k = sk_used;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+}
+static void ggml_vk_prealloc_report(const ggml_backend_vk_context * ctx) {
+    const vk_prealloc_stats & st = ctx->prealloc_stats;
+    if (!ggml_vk_prealloc_log() || st.max_x + st.max_y + st.max_sk == 0) {
+        return;
+    }
+    const double mib = 1024.0 * 1024.0;
+    const uint64_t stock = st.max_x + st.max_y + st.max_sk;
+    const uint64_t shared = st.max_y + st.max_xsk;
+    fprintf(stderr, "ggml_vulkan: %s prealloc: x %.1f MiB (%s), y %.1f MiB (%s), split-k %.1f MiB (%s); stock x+y+sk = %.1f MiB; "
+            "largest x+sk of one op %.1f MiB (%s), so x+sk shared + y = %.1f MiB, saving %.1f MiB; buffers now: alias %s, x %.1f MiB, sk %.1f MiB\n",
+            ctx->name.c_str(), st.max_x / mib, st.who_x.c_str(), st.max_y / mib, st.who_y.c_str(), st.max_sk / mib, st.who_sk.c_str(),
+            stock / mib, st.max_xsk / mib, st.who_xsk.c_str(), shared / mib, (stock > shared ? stock - shared : 0) / mib,
+            ggml_vk_prealloc_alias() ? "on" : "off", ctx->prealloc_size_x / mib, ctx->prealloc_size_split_k / mib);
+}
