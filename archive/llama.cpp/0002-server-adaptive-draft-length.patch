+    // moe-cache patch 0002 (L08): decayed acceptance counts, used only when LLAMA_SPEC_ADAPT=1
+    double spec_adapt_succ   = 0.0; // accepted draft tokens
+    double spec_adapt_trials = 0.0; // draft positions that were tested (accepted ones + the first rejected one)
+    int    spec_adapt_idle   = 0;   // steps spent at length 0
+
+    // draft length cap from {0, 1, 2, 4}: maximise expected tokens per step / (1 + cost * length),
+    // with a per-position acceptance rate alpha and E(k) = 1 + alpha + ... + alpha^k
+    int spec_adapt_cap() {
+        const auto & env = server_spec_adapt_get();
+        if (!env.on) {
+            return INT32_MAX;
+        }
+        if (spec_adapt_trials < 1.0) {
+            return 4; // nothing observed yet
+        }
+        const double alpha = std::min(0.999, spec_adapt_succ / spec_adapt_trials);
+        int    best       = 0;
+        double best_score = 1.0;
+        for (int k : { 1, 2, 4 }) {
+            const double score = (1.0 - std::pow(alpha, k + 1)) / (1.0 - alpha) / (1.0 + env.cost * k);
+            if (score > best_score * (1.0 + 1e-9)) {
+                best       = k;
+                best_score = score;
+            }
+        }
+        if (best == 0 && ++spec_adapt_idle >= env.probe) {
+            spec_adapt_idle = 0;
+            return 1; // probe, so a change of the text can be noticed
+        }
+        return best;
+    }
+
+    void spec_adapt_update(size_t n_draft, size_t n_accepted) {
+        if (!server_spec_adapt_get().on || n_draft == 0) {
+            return;
+        }
+        spec_adapt_succ   = spec_adapt_succ   * 0.9 + (double) n_accepted;
+        spec_adapt_trials = spec_adapt_trials * 0.9 + (double) (n_accepted < n_draft ? n_accepted + 1 : n_draft);
+    }
