+// moe-cache patch 0002 (L08): adaptive draft length. Off unless LLAMA_SPEC_ADAPT=1.
+//   LLAMA_SPEC_ADAPT_COST  relative cost of one extra drafted token in a verification step (default 0.15)
+//   LLAMA_SPEC_ADAPT_PROBE steps spent at draft length 0 before one probe step at length 1 (default 16)
+struct server_spec_adapt_env {
+    bool   on    = false;
+    double cost  = 0.15;
+    int    probe = 16;
+
+    server_spec_adapt_env() {
+        const char * e = getenv("LLAMA_SPEC_ADAPT");
+        on = e != nullptr && atoi(e) != 0;
+        if ((e = getenv("LLAMA_SPEC_ADAPT_COST")) != nullptr && atof(e) >= 0.0) { cost  = atof(e); }
+        if ((e = getenv("LLAMA_SPEC_ADAPT_PROBE")) != nullptr && atoi(e) > 0)   { probe = atoi(e); }
+    }
+};
+
+static const server_spec_adapt_env & server_spec_adapt_get() {
+    static const server_spec_adapt_env env;
+    return env;
+}
+
 struct server_slot {
