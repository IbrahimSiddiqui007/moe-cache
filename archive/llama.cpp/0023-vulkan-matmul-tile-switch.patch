                 device->mul_mat_id_s[i] = false;
             }
 #endif
+            // GGML_VK_AMD_LARGE_TILE=1 (default off): AMD with coopmat uses the 128x128 tile for MUL_MAT and MUL_MAT_ID, also on the proprietary driver
+            // GGML_VK_MMID_SMALL_TILE=1 (default off): MUL_MAT_ID uses only the small tile (any vendor)
+            static const bool amd_large = getenv("GGML_VK_AMD_LARGE_TILE") && atoi(getenv("GGML_VK_AMD_LARGE_TILE")) > 0;
+            static const bool id_small  = getenv("GGML_VK_MMID_SMALL_TILE") && atoi(getenv("GGML_VK_MMID_SMALL_TILE")) > 0;
+            if (amd_large && device->vendor_id == VK_VENDOR_ID_AMD && device->coopmat_support) {
+                device->mul_mat_l[i]    = true;
